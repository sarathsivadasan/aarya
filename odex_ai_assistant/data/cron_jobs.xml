<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cleanup old AI usage logs -->
        <record id="cron_cleanup_ai_logs" model="ir.cron">
            <field name="name">ODEX AI: Cleanup Old Usage Logs</field>
            <field name="model_id" ref="model_odex_ai_usage_log"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="priority">100</field>
        </record>

        <!-- Archive old inactive conversations -->
        <record id="cron_archive_conversations" model="ir.cron">
            <field name="name">ODEX AI: Archive Inactive Conversations</field>
            <field name="model_id" ref="model_odex_ai_conversation"/>
            <field name="state">code</field>
            <field name="code">
from datetime import datetime, timedelta
cutoff = datetime.now() - timedelta(days=90)
old_convs = model.search([
    ('write_date', '&lt;', cutoff),
    ('state', '=', 'active'),
    ('is_pinned', '=', False),
])
old_convs.write({'active': False})
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="priority">100</field>
        </record>

    </data>
</odoo>
