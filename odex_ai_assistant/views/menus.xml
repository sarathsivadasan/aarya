<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Root Menu -->
        <menuitem id="menu_ai_root"
                  name="AI Assistant"
                  web_icon="odex_ai_assistant,static/description/icon.png"
                  sequence="100"
                  groups="odex_ai_assistant.group_ai_user"/>

        <!-- Conversations Menu -->
        <menuitem id="menu_ai_conversations"
                  name="Conversations"
                  parent="menu_ai_root"
                  action="action_ai_conversations"
                  sequence="10"
                  groups="odex_ai_assistant.group_ai_user"/>

        <!-- Templates Menu -->
        <menuitem id="menu_ai_templates"
                  name="Prompt Templates"
                  parent="menu_ai_root"
                  action="action_ai_prompt_templates"
                  sequence="20"
                  groups="odex_ai_assistant.group_ai_manager"/>

        <!-- Analytics Submenu -->
        <menuitem id="menu_ai_analytics"
                  name="Analytics"
                  parent="menu_ai_root"
                  sequence="30"
                  groups="odex_ai_assistant.group_ai_manager"/>

        <menuitem id="menu_ai_usage_logs"
                  name="Usage Logs"
                  parent="menu_ai_analytics"
                  action="action_ai_usage_logs"
                  sequence="10"
                  groups="odex_ai_assistant.group_ai_manager"/>

        <menuitem id="menu_ai_feedback"
                  name="Feedback"
                  parent="menu_ai_analytics"
                  action="action_ai_feedback"
                  sequence="20"
                  groups="odex_ai_assistant.group_ai_manager"/>

        <!-- Settings shortcut -->
        <menuitem id="menu_ai_settings"
                  name="Settings"
                  parent="menu_ai_root"
                  action="base_setup.action_general_configuration"
                  sequence="100"
                  groups="odex_ai_assistant.group_ai_manager"/>

    </data>
</odoo>
