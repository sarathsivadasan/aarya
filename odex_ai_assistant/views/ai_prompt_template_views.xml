<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_ai_prompt_template_list" model="ir.ui.view">
            <field name="name">odex.ai.prompt.template.list</field>
            <field name="model">odex.ai.prompt.template</field>
            <field name="arch" type="xml">
                <list string="Prompt Templates" editable="top">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="category"/>
                    <field name="applicable_model" optional="show"/>
                    <field name="description"/>
                    <field name="use_count" string="Uses"/>
                    <field name="is_system" optional="hide"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_ai_prompt_template_form" model="ir.ui.view">
            <field name="name">odex.ai.prompt.template.form</field>
            <field name="model">odex.ai.prompt.template</field>
            <field name="arch" type="xml">
                <form string="Prompt Template">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Template Name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="category"/>
                                <field name="icon"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="applicable_model"
                                       placeholder="Leave empty for all models"/>
                                <field name="use_count" readonly="1"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group>
                            <field name="description"
                                   placeholder="Short description shown as tooltip"/>
                        </group>
                        <group string="Prompt Text">
                            <field name="prompt_text" nolabel="1"
                                   placeholder="Enter your prompt template here. Use {record_data} for current record context, {user_name} for current user name, {company_name} for company name."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_ai_prompt_template_kanban" model="ir.ui.view">
            <field name="name">odex.ai.prompt.template.kanban</field>
            <field name="model">odex.ai.prompt.template</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="category">
                    <field name="name"/>
                    <field name="category"/>
                    <field name="icon"/>
                    <field name="description"/>
                    <field name="use_count"/>
                    <templates>
                        <t t-name="card">
                            <div class="p-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i t-attf-class="fa #{record.icon.value} me-2 text-primary"/>
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="text-muted small"><field name="description"/></div>
                                <div class="mt-2 text-end small text-muted">
                                    Used <field name="use_count"/> times
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_ai_prompt_template_search" model="ir.ui.view">
            <field name="name">odex.ai.prompt.template.search</field>
            <field name="model">odex.ai.prompt.template</field>
            <field name="arch" type="xml">
                <search string="Search Templates">
                    <field name="name"/>
                    <field name="category"/>
                    <filter string="General" name="general"
                            domain="[('category', '=', 'general')]"/>
                    <filter string="Vehicle" name="vehicle"
                            domain="[('category', '=', 'vehicle')]"/>
                    <filter string="Workshop" name="workshop"
                            domain="[('category', 'in', ['job_card', 'workshop', 'inspection'])]"/>
                    <filter string="System Templates" name="system"
                            domain="[('is_system', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Category" name="group_category"
                                context="{'group_by': 'category'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_ai_prompt_templates" model="ir.actions.act_window">
            <field name="name">Prompt Templates</field>
            <field name="res_model">odex.ai.prompt.template</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="search_view_id" ref="view_ai_prompt_template_search"/>
        </record>

    </data>
</odoo>
