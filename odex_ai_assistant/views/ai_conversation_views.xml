<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Conversation List View -->
        <record id="view_ai_conversation_list" model="ir.ui.view">
            <field name="name">odex.ai.conversation.list</field>
            <field name="model">odex.ai.conversation</field>
            <field name="arch" type="xml">
                <list string="AI Conversations" decoration-muted="state == 'archived'"
                      decoration-info="is_pinned == True">
                    <field name="name"/>
                    <field name="user_id" optional="show"/>
                    <field name="message_count" string="Messages"/>
                    <field name="total_tokens" string="Tokens"/>
                    <field name="last_message_date"/>
                    <field name="state"/>
                    <field name="is_pinned" widget="boolean_toggle"/>
                    <field name="res_model" optional="hide"/>
                    <field name="res_name" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Conversation Form View -->
        <record id="view_ai_conversation_form" model="ir.ui.view">
            <field name="name">odex.ai.conversation.form</field>
            <field name="model">odex.ai.conversation</field>
            <field name="arch" type="xml">
                <form string="AI Conversation">
                    <header>
                        <button name="action_pin" string="Pin" type="object"
                                class="btn-secondary"
                                invisible="is_pinned == True"/>
                        <button name="action_unpin" string="Unpin" type="object"
                                class="btn-secondary"
                                invisible="is_pinned == False"/>
                        <button name="action_archive" string="Archive" type="object"
                                class="btn-secondary"
                                invisible="state == 'archived'"/>
                        <button name="action_clear_messages" string="Clear Messages"
                                type="object" class="btn-danger"
                                confirm="This will delete all messages in this conversation. Continue?"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="active,pinned,archived"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Conversation Title"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="last_message_date"/>
                                <field name="total_tokens"/>
                            </group>
                            <group>
                                <field name="res_model"/>
                                <field name="res_name"/>
                                <field name="message_count"/>
                                <field name="is_pinned"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Messages" name="messages">
                                <field name="message_ids" widget="one2many_list" readonly="1">
                                    <list>
                                        <field name="create_date" string="Time"/>
                                        <field name="role"/>
                                        <field name="content"/>
                                        <field name="tokens_used"/>
                                        <field name="model_used" optional="hide"/>
                                        <field name="feedback" optional="show"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Summary" name="summary">
                                <field name="summary" placeholder="Auto-generated summary will appear here..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_ai_conversation_search" model="ir.ui.view">
            <field name="name">odex.ai.conversation.search</field>
            <field name="model">odex.ai.conversation</field>
            <field name="arch" type="xml">
                <search string="Search Conversations">
                    <field name="name" string="Title"/>
                    <field name="user_id"/>
                    <field name="res_name" string="Related Record"/>
                    <filter string="My Conversations" name="my_conversations"
                            domain="[('user_id', '=', uid)]"/>
                    <filter string="Pinned" name="pinned"
                            domain="[('is_pinned', '=', True)]"/>
                    <filter string="Active" name="active"
                            domain="[('state', '=', 'active')]"/>
                    <filter string="Archived" name="archived"
                            domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter string="User" name="group_user"
                                context="{'group_by': 'user_id'}"/>
                        <filter string="State" name="group_state"
                                context="{'group_by': 'state'}"/>
                        <filter string="Related Model" name="group_model"
                                context="{'group_by': 'res_model'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_ai_conversations" model="ir.actions.act_window">
            <field name="name">AI Conversations</field>
            <field name="res_model">odex.ai.conversation</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_ai_conversation_search"/>
            <field name="context">{'search_default_my_conversations': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No AI conversations yet!
                </p>
                <p>
                    Start chatting with the ODEX AI Assistant by clicking the
                    <strong>AI icon</strong> in the top navigation bar.
                </p>
            </field>
        </record>

    </data>
</odoo>
