<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_employee_asset_assignment_company" model="ir.rule">
            <field name="name">Employee Asset Assignment: multi-company</field>
            <field name="model_id" ref="model_employee_asset_assignment"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_employee_asset_assignment_own" model="ir.rule">
            <field name="name">Employee Asset Assignment: own assets only</field>
            <field name="model_id" ref="model_employee_asset_assignment"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_employee_asset_assignment_hr" model="ir.rule">
            <field name="name">Employee Asset Assignment: HR sees all</field>
            <field name="model_id" ref="model_employee_asset_assignment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

    </data>
</odoo>
