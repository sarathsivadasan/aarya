<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vendor Portal: View &amp; Submit Quotation ───────────────────── -->
    <template id="portal_multi_rfq_page" name="Multi RFQ Vendor Portal Page">
        <t t-call="portal.portal_layout">
            <t t-set="o_portal_fullwidth_alert" groups="purchase.group_purchase_user">
                <t t-call="portal.portal_back_in_edit_mode">
                    <t t-set="backend_url"
                       t-value="'/odoo/purchase/%s' % order.id"/>
                </t>
            </t>

            <div class="o_portal_wrap">
                <div class="container">
                    <div class="row mt-4">
                        <div class="col-12 col-lg-8 offset-lg-2">

                            <!-- Header -->
                            <div class="card mb-4">
                                <div class="card-header bg-primary text-white">
                                    <h4 class="mb-0">
                                        <i class="fa fa-file-text-o me-2"/>
                                        Request for Quotation — <t t-esc="order.name"/>
                                    </h4>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-6">
                                            <p><strong>From:</strong>
                                                <t t-esc="order.company_id.name"/>
                                            </p>
                                            <p><strong>Deadline:</strong>
                                                <t t-if="order.date_planned">
                                                    <t t-esc="order.date_planned"
                                                       t-options='{"widget": "datetime"}'/>
                                                </t>
                                                <t t-else="">—</t>
                                            </p>
                                        </div>
                                        <div class="col-6">
                                            <p><strong>Contact:</strong>
                                                <t t-esc="order.user_id.name"/>
                                            </p>
                                            <p><strong>Currency:</strong>
                                                <t t-esc="order.currency_id.name"/>
                                            </p>
                                        </div>
                                    </div>
                                    <t t-if="order.notes">
                                        <div class="alert alert-info">
                                            <strong>Notes:</strong>
                                            <span t-field="order.notes"/>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Success message if already submitted -->
                            <t t-if="order.vendor_submitted">
                                <div class="alert alert-success">
                                    <i class="fa fa-check-circle me-2"/>
                                    <strong>Your quotation has been submitted successfully.</strong>
                                    You can update your prices below and resubmit if needed.
                                </div>
                            </t>

                            <!-- Product lines / price entry form -->
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0">Products — Enter Your Prices</h5>
                                </div>
                                <div class="card-body p-0">
                                    <form method="post"
                                          t-attf-action="/rfq/portal/submit/#{order.id}"
                                          class="o_portal_rfq_form">
                                        <input type="hidden" name="csrf_token"
                                               t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="access_token"
                                               t-att-value="access_token"/>

                                        <table class="table table-sm table-hover mb-0">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>#</th>
                                                    <th>Product</th>
                                                    <th class="text-end">Qty</th>
                                                    <th>UoM</th>
                                                    <th class="text-end">
                                                        Unit Price *
                                                    </th>
                                                    <th class="text-end">Subtotal</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="order.order_line"
                                                   t-as="line">
                                                    <tr>
                                                        <td>
                                                            <t t-esc="line_index + 1"/>
                                                        </td>
                                                        <td>
                                                            <t t-esc="line.product_id.name"/>
                                                            <t t-if="line.name and line.name != line.product_id.name">
                                                                <br/>
                                                                <small class="text-muted">
                                                                    <t t-esc="line.name"/>
                                                                </small>
                                                            </t>
                                                        </td>
                                                        <td class="text-end">
                                                            <t t-esc="line.product_qty"/>
                                                        </td>
                                                        <td>
                                                            <t t-esc="line.product_uom.name"/>
                                                        </td>
                                                        <td class="text-end">
                                                            <input type="number"
                                                                   step="0.01"
                                                                   min="0"
                                                                   t-attf-name="price_unit_#{line.id}"
                                                                   t-att-value="line.price_unit or ''"
                                                                   class="form-control form-control-sm text-end"
                                                                   style="width:120px;display:inline-block"
                                                                   placeholder="0.00"
                                                                   required="required"/>
                                                        </td>
                                                        <td class="text-end text-muted">
                                                            <span t-attf-id="subtotal_#{line.id}">
                                                                <t t-esc="line.price_subtotal"
                                                                   t-options='{"widget":"monetary","display_currency":order.currency_id}'/>
                                                            </span>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>

                                        <!-- Extra fields -->
                                        <div class="p-3 border-top">
                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <label class="form-label">
                                                        Delivery Lead Time (days)
                                                    </label>
                                                    <input type="number"
                                                           name="lead_time"
                                                           class="form-control"
                                                           min="0"
                                                           placeholder="e.g. 7"/>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">
                                                        Quotation Validity Date
                                                    </label>
                                                    <input type="date"
                                                           name="validity_date"
                                                           class="form-control"/>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">Notes</label>
                                                    <input type="text"
                                                           name="vendor_notes"
                                                           class="form-control"
                                                           placeholder="Any remarks..."/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="p-3 border-top d-flex justify-content-end gap-2">
                                            <button type="submit"
                                                    class="btn btn-primary">
                                                <i class="fa fa-send me-1"/>
                                                Submit Quotation
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ── Confirmation page ─────────────────────────────────────────────── -->
    <template id="portal_multi_rfq_submitted"
              name="Multi RFQ Vendor Portal Submitted">
        <t t-call="portal.portal_layout">
            <div class="container mt-5">
                <div class="row">
                    <div class="col-md-6 offset-md-3 text-center">
                        <div class="card">
                            <div class="card-body py-5">
                                <i class="fa fa-check-circle fa-4x text-success mb-3"/>
                                <h4>Quotation Submitted!</h4>
                                <p class="text-muted">
                                    Your quotation for
                                    <strong><t t-esc="order.name"/></strong>
                                    has been received. The purchasing team will
                                    review and get back to you.
                                </p>
                                <a href="/" class="btn btn-outline-primary mt-2">
                                    Go to Portal Home
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
