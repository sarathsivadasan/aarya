<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Form View ───────────────────────────────────────────────────────── -->
    <record id="view_purchase_multi_rfq_form" model="ir.ui.view">
        <field name="name">purchase.multi.rfq.form</field>
        <field name="model">purchase.multi.rfq</field>
        <field name="arch" type="xml">
            <form string="Multi Vendor RFQ">
                <header>
                    <button name="action_send_rfq"
                            string="Send RFQ"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['draft']"/>
                    <button name="action_resend_rfq"
                            string="Re-Send RFQ"
                            type="object"
                            invisible="state not in ['sent','received']"/>
<!--                     <button name="action_set_comparison"
                            string="Compare Quotations"
                            type="object"
                            invisible="state not in ['sent','received']"/> -->
                    <button name="request_for_quotation"
                            string="Request For Quotation"
                            type="object"
                            invisible="state not in ['sent']"/>
                    <button name="action_select_all_vendors"
                            string="Select All Vendors"
                            type="object"
                            invisible="state not in ['draft']"/>
                    <button name="action_cancel"
                            string="Cancel RFQ"
                            type="object"
                            groups="purchase.group_purchase_manager"
                            invisible="state in ['awarded','cancel']"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ['cancel']"/>
                    <button name="action_print_comparison_report"
                            string="Print Report"
                            type="object"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,sent,in_quoatation,awarded"/>
                </header>

                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_generated_rfqs"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="rfq_count"/>
                                </span>
                                <span class="o_stat_text">RFQs Sent</span>
                            </div>
                        </button>
                        <button name="action_view_quotations"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-handshake-o">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="quotation_count"/>
                                </span>
                                <span class="o_stat_text">Quotations</span>
                            </div>
                        </button>
                        <!-- <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="purchase_order_count"/>
                                </span>
                                <span class="o_stat_text">Purchase Orders</span>
                            </div>
                        </button> -->
                        <button class="oe_stat_button"
                                icon="fa-users"
                                type="object"
                                name="action_view_vendors">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="vendor_count"/>
                                </span>
                                <span class="o_stat_text">Vendors</span>
                            </div>
                        </button>
                        <button class="oe_stat_button"
                                icon="fa-cube"
                                type="object"
                                name="action_view_products">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="product_count"/>
                                </span>
                                <span class="o_stat_text">Products</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <!-- ── Two-column main layout ── -->
                    <div class="row">
                        <!-- LEFT: RFQ Details -->
                        <div class="col-md-8">
                            <group>
                                <group string="RFQ Details">
                                    <field name="rfq_deadline" widget="datetime"/>
                                    <field name="payment_term_id"/>
                                    <field name="purchase_user_id"
                                           widget="many2one_avatar_user"/>
                                    <field name="currency_id"
                                           groups="base.group_multi_currency"/>
                                    <field name="company_id"
                                           groups="base.group_multi_company"/>
                                </group>
                                <group string="Vehicle Details">
                                    <field name="vehicle_id"/>
                                    <field name="vehicle_make_id"/>
                                    <field name="vehicle_model_id"/>
                                    <field name="vin"/>
                                    <field name="vehicle_color_id"/>
                                    <field name="engin_no"/>
                                    <field name="year"/>       
                                </group>
                                <group string="Documents">
                                    <field name="mulkiya_filename" invisible="1"/>
                                    <field name="mulkiya_attachment"
                                           filename="mulkiya_filename"
                                           widget="binary"
                                           string="Mulkiya Copy"/>
                                </group>
                                <group string="Notes">
                                    <field name="notes"
                                           nolabel="1"
                                           placeholder="Notes for vendors..."/>
                                </group>
                            </group>
                        </div>

                        <!-- RIGHT: Vendor Selection -->
                        <div class="col-md-4">
                            <separator string="Vendors"/>
                            <field name="vendor_ids"
                                   widget="many2many_tags"
                                   options="{'no_create_edit': True}"
                                   domain="[('supplier_rank','>',0)]"
                                   placeholder="Add vendors..."/>

                            <div class="mt-2 mb-2">
                                <span class="text-muted" style="font-size:12px;">
                                    <field name="vendor_count"
                                           class="d-inline"/> Vendor(s) Selected
                                </span>
                            </div>

                            <!-- Info box in draft -->
                            <div class="alert alert-info mt-2"
                                 role="alert"
                                 style="font-size:12px"
                                 invisible="state not in ['draft']">
                                <i class="fa fa-info-circle me-1"/>
                                RFQ will be sent to all selected vendors.
                                Once they submit, you can compare and award.
                            </div>

                            <!-- Portal share links after sending -->
                            <div invisible="state not in ['sent','received','awarded']">
                                <separator string="Portal Share Links"/>
                                <field name="generated_rfq_ids"
                                       widget="one2many"
                                       readonly="1">
                                    <list string="Vendor Links"
                                          create="0"
                                          delete="0">
                                        <field name="partner_id" string="Vendor"/>
                                        <field name="state"
                                               widget="badge"
                                               decoration-success="state=='purchase'"
                                               decoration-warning="state=='sent'"
                                               decoration-muted="state=='cancel'"/>
                                        <button name="action_send_rfq_via_email"
                                                string="Send Link"
                                                type="object"
                                                icon="fa-share-alt"
                                                class="btn-sm btn-secondary"/>
                                    </list>
                                </field>
                            </div>
                        </div>
                    </div>

                    <notebook>
                        <!-- Tab 1: Products -->
                        <page string="Products" name="products_tab">
                            <field name="line_ids" widget="one2many" mode="list">
                                <list editable="bottom" string="Product Lines">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"
                                           options="{'no_create_edit': True}"/>
                                    <field name="part_no"/>
                                    <field name="parts_type"/>
                                    <field name="vehicle_make_id"/>
                                    <field name="description" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"
                                           options="{'no_create_edit': True}"
                                           groups="uom.group_uom"/>
                                    <field name="expected_date" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <!-- Tab 2: Quotation Comparison -->
                        <page string="Quotation Comparison"
                              name="comparison"
                              invisible="state not in ['sent','received','in_quoatation','awarded']">
                            <div class="alert alert-info"
                                 role="alert"
                                 invisible="quotation_count > 0">
                                <i class="fa fa-info-circle"/> Waiting for vendors to submit quotations.
                            </div>
                            <div invisible="quotation_count == 0">
                                <field name="comparison_html" nolabel="1" readonly="1"/>

<!--                                 <div class="o_row mt-3"
                                     invisible="state in ['awarded','cancel']">
                                    <button name="action_award_complete"
                                            string="Award Complete RFQ"
                                            type="object"
                                            class="btn-primary me-2"
                                            groups="purchase.group_purchase_manager"
                                            icon="fa-trophy"/>
                                    <button name="action_award_line_wise"
                                            string="Award Line Wise"
                                            type="object"
                                            class="btn-secondary"
                                            groups="purchase.group_purchase_manager"
                                            icon="fa-list"/>
                                </div> -->

                                <div class="alert alert-success mt-3"
                                     role="alert"
                                     invisible="state != 'awarded'">
                                    <i class="fa fa-check-circle"/>
                                    Awarded (<field name="award_type" readonly="1" nolabel="1" class="d-inline"/>)
                                    on <field name="award_date" readonly="1" nolabel="1" class="d-inline"/>
                                    — Vendor(s):
                                    <field name="awarded_vendor_ids"
                                           widget="many2many_tags"
                                           readonly="1"
                                           nolabel="1"
                                           class="d-inline"/>
                                </div>
                            </div>
                        </page>

                        <!-- Tab 3: Notes -->
                        <page string="Notes" name="notes_tab">
                            <field name="notes"
                                   placeholder="Internal notes, special instructions for vendors..."/>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List View ───────────────────────────────────────────────────────── -->
    <record id="view_purchase_multi_rfq_list" model="ir.ui.view">
        <field name="name">purchase.multi.rfq.list</field>
        <field name="model">purchase.multi.rfq</field>
        <field name="arch" type="xml">
            <list string="Multi Vendor RFQs"
                  decoration-success="state=='awarded'"
                  decoration-muted="state=='cancel'"
                  decoration-warning="state=='in_quoatation'">
                <field name="name"/>
                <field name="rfq_deadline"/>
                <field name="purchase_user_id"
                       widget="many2one_avatar_user"
                       optional="show"/>
                <field name="vehicle_id"/>
                <field name="vehicle_make_id"/>
                <field name="vehicle_model_id"/>
                <field name="vin"/>
                <field name="vehicle_color_id"/>
                <field name="engin_no"/>
                <field name="year"/>
                <field name="vendor_count" string="Vendors"/>
                <field name="product_count" string="Products"/>
                <field name="rfq_count" string="RFQs Sent"/>
                <field name="quotation_count" string="Quotations"/>
                <field name="purchase_order_count" string="POs"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="hide"/>
                <field name="currency_id"
                       groups="base.group_multi_currency"
                       optional="hide"/>
                <field name="state"
                       widget="badge"
                       decoration-success="state=='awarded'"
                       decoration-warning="state in ['sent','received']"
                       decoration-muted="state=='cancel'"
                       decoration-info="state=='draft'"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban View ─────────────────────────────────────────────────────── -->
    <record id="view_purchase_multi_rfq_kanban" model="ir.ui.view">
        <field name="name">purchase.multi.rfq.kanban</field>
        <field name="model">purchase.multi.rfq</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="state"/>
                <field name="vendor_count"/>
                <field name="product_count"/>
                <field name="rfq_deadline"/>
                <field name="purchase_user_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <field name="state"
                                       widget="label_selection"
                                       options="{'classes': {
                                           'draft':'default',
                                           'sent':'warning',
                                           'in_quoatation':'info',
                                           'awarded':'success',
                                           'cancel':'muted'}}"/>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <i class="fa fa-users"/>
                                    <field name="vendor_count"/> vendors ·
                                    <i class="fa fa-cube"/>
                                    <field name="product_count"/> products
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="purchase_user_id"
                                           widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Search View ─────────────────────────────────────────────────────── -->
    <record id="view_purchase_multi_rfq_search" model="ir.ui.view">
        <field name="name">purchase.multi.rfq.search</field>
        <field name="model">purchase.multi.rfq</field>
        <field name="arch" type="xml">
            <search string="Multi Vendor RFQ">
                <field name="name" string="Reference"/>
                <field name="vendor_ids" string="Vendor"/>
                <field name="purchase_user_id" string="Purchase Representative"/>
                <filter string="Draft" name="draft"
                        domain="[('state','=','draft')]"/>
                <filter string="RFQ Sent" name="sent"
                        domain="[('state','=','sent')]"/>
                <filter string="In Quoatation" name="in_quoatation"
                        domain="[('state','=','in_quoatation')]"/>
                <filter string="Awarded" name="awarded"
                        domain="[('state','=','awarded')]"/>
                <filter string="Cancelled" name="cancel"
                        domain="[('state','=','cancel')]"/>
                <separator/>
                <filter string="My RFQs" name="my_rfqs"
                        domain="[('purchase_user_id','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by':'state'}"/>
                    <filter string="Purchase Rep" name="group_user"
                            context="{'group_by':'purchase_user_id'}"/>
                    <filter string="Company" name="group_company"
                            context="{'group_by':'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Window Action ───────────────────────────────────────────────────── -->
    <record id="action_purchase_multi_rfq" model="ir.actions.act_window">
        <field name="name">Multi Vendor RFQ</field>
        <field name="res_model">purchase.multi.rfq</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_purchase_multi_rfq_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Multi Vendor RFQ
            </p>
            <p>
                Send a single RFQ to multiple vendors, compare prices,
                and award the best deal.
            </p>
        </field>
    </record>

</odoo>
