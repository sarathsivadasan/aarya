<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_odex_multi_rfq_company" model="ir.rule">
            <field name="name">Odex Multi RFQ: multi-company</field>
            <field name="model_id" ref="model_purchase_multi_rfq"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_odex_multi_rfq_user" model="ir.rule">
            <field name="name">Odex Multi RFQ: user sees own</field>
            <field name="model_id" ref="model_purchase_multi_rfq"/>
            <field name="domain_force">
                ['|', ('purchase_user_id', '=', user.id), ('purchase_user_id', '=', False)]
            </field>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_odex_multi_rfq_manager" model="ir.rule">
            <field name="name">Odex Multi RFQ: manager sees all</field>
            <field name="model_id" ref="model_purchase_multi_rfq"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
        </record>

    </data>
</odoo>
