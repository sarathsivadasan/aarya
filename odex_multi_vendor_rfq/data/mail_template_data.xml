<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_multi_rfq" model="mail.template">
            <field name="name">Odex Multi Vendor RFQ: Send to Vendor</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">Request for Quotation - {{ object.name }} from {{ object.company_id.name }}</field>
            <field name="email_from">{{ (object.company_id.partner_id.email or '') }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            <field name="body_html"><![CDATA[
<div style="font-family:Arial,sans-serif;font-size:13px;color:#333;max-width:680px;margin:0 auto">
    <div style="background:#7c3aed;padding:24px 28px;border-radius:6px 6px 0 0">
        <h2 style="color:#fff;margin:0;font-size:20px">Request for Quotation</h2>
        <p style="color:rgba(255,255,255,0.85);margin:6px 0 0;font-size:13px">
            {{ object.company_id.name }}
        </p>
    </div>
    <div style="background:#fff;border:1px solid #e5e7eb;border-top:none;padding:28px;border-radius:0 0 6px 6px">
        <p style="margin:0 0 16px">Dear <strong>{{ object.partner_id.name }}</strong>,</p>
        <p>We would like to invite you to submit a quotation for the following products.
           Please click the button below to view the details and submit your prices.</p>

        <table style="width:100%;border-collapse:collapse;margin:20px 0;font-size:13px">
            <thead>
                <tr style="background:#f9fafb">
                    <th style="text-align:left;padding:8px 12px;border:1px solid #e5e7eb">#</th>
                    <th style="text-align:left;padding:8px 12px;border:1px solid #e5e7eb">Product</th>
                    <th style="text-align:right;padding:8px 12px;border:1px solid #e5e7eb">Qty</th>
                    <th style="text-align:left;padding:8px 12px;border:1px solid #e5e7eb">UoM</th>
                </tr>
            </thead>
            <tbody>
                % for line in object.order_line:
                <tr>
                    <td style="padding:8px 12px;border:1px solid #e5e7eb">${loop_index + 1}</td>
                    <td style="padding:8px 12px;border:1px solid #e5e7eb">${line.product_id.name}</td>
                    <td style="padding:8px 12px;border:1px solid #e5e7eb;text-align:right">${line.product_qty}</td>
                    <td style="padding:8px 12px;border:1px solid #e5e7eb">${line.product_uom.name}</td>
                </tr>
                % endfor
            </tbody>
        </table>

        % if object.date_planned:
        <div style="margin:20px 0">
            <strong>Deadline:</strong> ${format_datetime(object.date_planned)}
        </div>
        % endif

        % if object.notes:
        <div style="background:#f9fafb;border-left:4px solid #7c3aed;padding:12px 16px;margin:16px 0;border-radius:0 4px 4px 0">
            <strong>Notes:</strong> ${object.notes}
        </div>
        % endif

        <div style="text-align:center;margin:28px 0">
            <a href="${object.get_base_url()}/odoo/purchase/${object.id}"
               style="background:#7c3aed;color:#fff;text-decoration:none;padding:12px 28px;border-radius:5px;font-weight:bold;display:inline-block">
                View &amp; Submit Quotation
            </a>
        </div>

        <p style="color:#6b7280;font-size:12px;margin-top:24px">
            This email was sent by ${object.company_id.name}.<br/>
            Contact: ${object.user_id.name or 'Purchasing Team'}
        </p>
    </div>
</div>
            ]]></field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
