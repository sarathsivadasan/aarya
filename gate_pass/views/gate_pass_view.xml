<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="gate_pass_form_view" model="ir.ui.view">
            <field name="name">vehicle.gate.pass.form.view</field>
            <field name="model">fleet.gate.pass</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="vehicle_out" type="object" string="Out" invisible="state not in ('in', 'revisit')"
                                class="btn-primary"/>
                        <button name="vehicle_revisit" type="object" string="Revisit"   invisible="state != 'in'" class="btn-primary"/>
                        <!-- <button name="action_create_vehicle_inspection"
                                type="object"
                                string="Create Vehicle Inspection"
                                class="btn-primary" invisible="inspection_count >= 1"/> -->
                        <!-- <button name="user_reject" type="object" string="Reject" invisible="state != 'draft'" class="btn-primary"/> -->
                        <field name="state" widget="statusbar" string="Status"
                               statusbar_visible="in, revisit, out"/>
                    </header>
                    <sheet>
                        <!-- <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object" icon="fa-truck" name="show_picking" string="Delivery Order" groups="base.group_user"/>
                        </div>  -->
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_job_card" type="object" class="oe_stat_button"
                                    icon="fa-file-text-o" invisible="job_card_count == 0">
                                <field name="job_card_count" widget="statinfo" string="Job Cards"/>
                            </button>
                            <!-- <button name="action_view_vehicle_inspection"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-car"
                                    invisible="inspection_count == 0">
                                <field name="inspection_count"
                                       widget="statinfo"
                                       string="Vehicle Inspection"/>
                            </button> -->

                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="name" string="Name"/>
                                <br/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" readonly="1" force_save="1"/>
                                <field name="partner_phone"/>
                                <field name="partner_email"/>
                                <field name="alternate_contact" readonly="state != 'in'"/>
                                <field name="alternate_mobile" readonly="state != 'in'"/>
                            </group>
                            <group>
                                <field name="vehicle_id" readonly="state != 'in'"/>
                                <field name="brand_id"/>
                                <field name="model_id"/>
                                <field name="vehicle_color_id"/>
                                <field name="approved_id" readonly="state != 'in'"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="date_in"/>
                            </group>
                            <group>
                                <field name="date_out"/>
                            </group>
                        </group>
                        <group>
                             <field name="note" placeholder="Add an internal note..." nolabel="1" height="50"/>
                        </group>
                    </sheet>
                    <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <record id="gate_pass_tree_view" model="ir.ui.view">
            <field name="name">vehicle.gate.pass.view.list</field>
            <field name="model">fleet.gate.pass</field>
            <field name="arch" type="xml">
                <list>
                    <field name="state"/>
                    <field name="name"/>
                    <field name="date_in"/>
                    <field name="date_out"/>
                    <field name="partner_id"/>
                    <field name="vehicle_id"/>
                    <field name="brand_id"/>
                    <field name="model_id"/>
                    <field name="vehicle_color_id"/>
                    <field name="partner_phone"/>
                    <field name="approved_id"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_gate_pass">
            <field name="name">Vehicle Gate Pass</field>
            <field name="res_model">fleet.gate.pass</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_gate_pass_parent" name="Gate Pass" groups="base.group_user"/>
        <!-- web_icon="parts_request,static/description/icon.png"/> -->
        <menuitem id="menu_item_gate_pass" name="Gate Pass" parent="menu_gate_pass_parent"/>
        <menuitem id="menu_action_gate_pass" name="Gate Pass" parent="menu_item_gate_pass" action="action_gate_pass"/>

    </data>
</odoo>