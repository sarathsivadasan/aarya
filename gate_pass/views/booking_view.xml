<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Booking form: smart button to the gate pass created on arrival -->
    <record id="view_workshop_booking_form_gate_pass" model="ir.ui.view">
        <field name="name">odex.workshop.booking.form.gate.pass</field>
        <field name="model">odex.workshop.booking</field>
        <field name="inherit_id" ref="odex_workshop_booking.view_workshop_booking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_gate_pass" type="object"
                        class="oe_stat_button" icon="fa-car"
                        invisible="not gate_pass_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Gate Pass</span>
                        <field name="gate_pass_id" invisible="1"/>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
