<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_custom_size" model="report.paperformat">
        <field name="name">Custom Size for Vehicale Inspection Report</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">33</field>
        <field name="margin_left">3</field>
        <field name="header_line" eval="False"/>  <!-- Enable header line -->
        <field name="dpi">90</field>
        <field name="header_spacing">30</field>  <!-- Add spacing for header -->
    </record>

    <record id="action_report_vehicle_inspection" model="ir.actions.report">
        <field name="name">Vehicle Inspection Report</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vehicle_inspection_report.report_vehicle_inspection</field>
        <field name="report_file">vehicle_inspection_report.report_vehicle_inspection</field>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="vehicle_inspection_report.paperformat_custom_size" />
    </record>
</odoo>