<odoo>

    <template id="external_layout_standard_vehical" inherit_id="job_card_extension.external_layout_standard">
        <xpath expr="//div[contains(@t-attf-class, 'footer')]" position="replace">
        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
            <div class="last-page" style="position:relative;margin-top:0;">
                <div class="signature-box clearfix"
                     style="padding-top: 10px; font-size: 16px; font-family: 'Times New Roman', Times, serif;">
                    <div style="width: 45%; display: inline-block;">
                        <p style="font-weight: bold; color: black; font-size:14px;">Name:
                            ............................................
                        </p>
                        <p style="font-weight: bold; color: black; font-size:14px; margin-top: -10px; ">
                            User Name:
                            <span t-field="o.create_uid.name"/>
                        </p>
                    </div>
                    <div style="width: 45%; display: inline-block; text-align: right;">
                        <p style="font-weight: bold; color: black; font-size:14px;">Signature:
                            ............................................
                        </p>
                        <p style="font-weight: bold; color: black; font-size:14px; margin-top: -10px; ">
                            Date:
                            <!-- <span t-field="o.cc_vehicle_in"/> -->
                        </p>
                    </div>
                </div>
            </div>
            <div class="text-center" style="border-top: 1px solid black;">
                <ul class="list-inline mb4">
                    <div t-field="company.report_footer"/>
                </ul>

                <div t-if="report_type == 'pdf'" class="text-muted">
                    Page:
                    <span class="page"/>
                    /
                    <span class="topage"/>
                </div>
                <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted">
                    <span t-field="o.name"/>
                </div>
            </div>
        </div>
    </xpath>
    </template>

