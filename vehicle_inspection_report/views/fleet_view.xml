<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="fleet_vehicle_vc_form_view" model="ir.ui.view">
        <field name="name">Vehicle Form vc Extend</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[@name='open_assignation_logs']" position="before">
                <button name="action_vehicle_inspection_list" type="object" class="oe_stat_button" icon="fa-history">
                    <field name="count_inspection" widget="statinfo" string="Vehicle Inspection"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>