<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== PETTY CASH RECEIVED VIEWS ==================== -->

    <!-- List View -->
    <record id="view_petty_cash_received_list" model="ir.ui.view">
        <field name="name">petty.cash.received.list</field>
        <field name="model">petty.cash.received</field>
        <field name="arch" type="xml">
            <list string="Cash Received" decoration-success="state == 'posted'" decoration-muted="state == 'cancelled'">
                <field name="date"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="description"/>
                <field name="received_by"/>
                <field name="journal_id"/>
                <field name="amount" sum="Total Received"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-warning="state == 'draft'" decoration-danger="state == 'cancelled'"/>
                <field name="company_id" column_invisible="1"/>
                <button name="action_post" string="Post" type="object" icon="fa-check" invisible="state != 'draft'" class="btn-sm btn-primary"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_petty_cash_received_form" model="ir.ui.view">
        <field name="name">petty.cash.received.form</field>
        <field name="model">petty.cash.received</field>
        <field name="arch" type="xml">
            <form string="Cash Received">
                <header>
                    <button name="action_post" string="Post" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state not in ['posted', 'cancelled']"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ['cancelled']"/>
                    <button name="%(petty_cash_book.action_petty_cash_receipt_voucher_report)s" string="Print Receipt" type="action" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal_entry" type="object" class="oe_stat_button" icon="fa-book" invisible="move_id == False">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="reference" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Receipt Details">
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="description"/>
                            <field name="received_by"/>
                            <field name="notes" placeholder="Additional notes..."/>
                        </group>
                        <group string="Accounting">
                            <field name="journal_id"/>
                            <field name="cash_account_id"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
                <chatter reload_on_follower="True"/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_petty_cash_received_search" model="ir.ui.view">
        <field name="name">petty.cash.received.search</field>
        <field name="model">petty.cash.received</field>
        <field name="arch" type="xml">
            <search string="Search Cash Received">
                <field name="reference" string="Reference"/>
                <field name="partner_id" string="Partner"/>
                <field name="description" string="Description"/>
                <field name="received_by" string="Received By"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Posted" name="filter_posted" domain="[('state', '=', 'posted')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Today" name="filter_today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="filter_this_month" domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Received By" name="group_received_by" context="{'group_by': 'received_by'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Journal" name="group_journal" context="{'group_by': 'journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_petty_cash_received_kanban" model="ir.ui.view">
        <field name="name">petty.cash.received.kanban</field>
        <field name="model">petty.cash.received</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="reference"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="description"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="row mb-0 no-gutters">
                                <div class="col-8">
                                    <strong><field name="reference"/></strong>
                                    <div class="text-muted">
                                        <field name="date"/> | <field name="partner_id"/>
                                    </div>
                                    <div class="text-muted small"><field name="description"/></div>
                                </div>
                                <div class="col-4 text-end">
                                    <strong class="text-success">
                                        <field name="amount" widget="monetary"/>
                                    </strong>
                                    <div>
                                        <field name="state" widget="badge"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_petty_cash_received" model="ir.actions.act_window">
        <field name="name">Cash Received</field>
        <field name="res_model">petty.cash.received</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No cash received records yet!
            </p>
            <p>
                Start by recording your first cash receipt.
            </p>
        </field>
    </record>
</odoo>
