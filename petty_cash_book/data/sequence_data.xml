<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Petty Cash Received -->
        <record id="seq_petty_cash_received" model="ir.sequence">
            <field name="name">Petty Cash Received</field>
            <field name="code">petty.cash.received</field>
            <field name="prefix">PCR/%(year)s/</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Petty Cash Expense -->
        <record id="seq_petty_cash_expense" model="ir.sequence">
            <field name="name">Petty Cash Expense</field>
            <field name="code">petty.cash.expense</field>
            <field name="prefix">PCE/%(year)s/</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
