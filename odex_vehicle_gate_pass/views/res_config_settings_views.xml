<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.gate.pass</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Vehicle Gate Pass" name="odex_vehicle_gate_pass"
                     logo="/odex_vehicle_gate_pass/static/description/icon.png">
                    <block title="OCR" name="gp_ocr">
                        <setting string="OCR Provider"
                                 help="Choose how registration plates and Mulkiya cards are read.">
                            <field name="gp_ocr_provider"/>
                            <div class="content-group mt-2" invisible="gp_ocr_provider != 'api'">
                                <div class="row">
                                    <label for="gp_ocr_endpoint" class="col-lg-4 o_light_label"/>
                                    <field name="gp_ocr_endpoint"/>
                                </div>
                                <div class="row">
                                    <label for="gp_ocr_api_key" class="col-lg-4 o_light_label"/>
                                    <field name="gp_ocr_api_key" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Gatepass Out Rules" name="gp_rules">
                        <setting help="Block check-out until the inspection step is done.">
                            <field name="gp_require_inspection"/>
                        </setting>
                        <setting help="Block check-out until the invoice is fully paid.">
                            <field name="gp_require_payment"/>
                        </setting>
                        <setting help="Block check-out while major damage is unresolved.">
                            <field name="gp_block_major_damage"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_gate_pass_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'odex_vehicle_gate_pass'}</field>
    </record>
</odoo>
