<?xml version="1.0"?>
<odoo>
    <record model="ir.ui.view" id="vehicle_emirates_form_view">
        <field name="name">vehicle.emirates.form.view</field>
        <field name="model">fleet.emirates</field>
        <field name="arch" type="xml">
            <form string="Vehicle Emirates">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="vehicle_emirates_tree_view" model="ir.ui.view">
        <field name="name">vehicle.emirates.list.view</field>
        <field name="model">fleet.emirates</field>
        <field name="arch" type="xml">
            <list string="Vehicle Emirates">
                <field name="name"/>
            </list>
        </field>
    </record>
    
    <record id="action_view_vehicle_emirates" model="ir.actions.act_window">
        <field name="name">Vehicle Emirates</field>
        <field name="res_model">fleet.emirates</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem 
            action="action_view_vehicle_emirates"
            id="menu_vehicle_emirates"
            parent="fleet.fleet_configuration"
            sequence="21" />
</odoo>
