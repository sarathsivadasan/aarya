<?xml version="1.0"?>
<odoo>
    <record model="ir.ui.view" id="vehicle_plate_code_form_view">
        <field name="name">vehicle.plate.code.form.view</field>
        <field name="model">fleet.characters</field>
        <field name="arch" type="xml">
            <form string="Vehicle Plate Code">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="vehicle_plate_code_tree_view" model="ir.ui.view">
        <field name="name">vehicle.plate.code.list.view</field>
        <field name="model">fleet.characters</field>
        <field name="arch" type="xml">
            <list string="Vehicle Plate Code">
                <field name="name"/>
            </list>
        </field>
    </record>
    
    <record id="action_view_vehicle_plate_code" model="ir.actions.act_window">
        <field name="name">Vehicle Plate Code</field>
        <field name="res_model">fleet.characters</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem 
            action="action_view_vehicle_plate_code"
            id="menu_vehicle_plate_code"
            parent="fleet.fleet_configuration"
            sequence="22" />
</odoo>
