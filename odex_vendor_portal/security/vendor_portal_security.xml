<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_vendor_portal" model="res.groups">
        <field name="name">Vendor Portal</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        <field name="comment">Portal users flagged as Vendors. Grants read only
            access to their own RFQs, purchase orders and vendor bills through
            the Vendor Portal.</field>
    </record>

    <record id="purchase_order_vendor_portal_rule" model="ir.rule">
        <field name="name">Vendor Portal: own purchase orders / RFQs</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[
            ('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id]),
            ('state', '!=', 'draft')
        ]</field>
        <field name="groups" eval="[(4, ref('group_vendor_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="purchase_order_line_vendor_portal_rule" model="ir.rule">
        <field name="name">Vendor Portal: own purchase order lines</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="domain_force">[
            ('order_id.partner_id', 'child_of', [user.partner_id.commercial_partner_id.id]),
            ('order_id.state', '!=', 'draft')
        ]</field>
        <field name="groups" eval="[(4, ref('group_vendor_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="account_move_vendor_portal_rule" model="ir.rule">
        <field name="name">Vendor Portal: own vendor bills</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="domain_force">[
            ('move_type', 'in', ('in_invoice', 'in_refund', 'in_receipt')),
            ('state', '=', 'posted'),
            ('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])
        ]</field>
        <field name="groups" eval="[(4, ref('group_vendor_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="account_move_line_vendor_portal_rule" model="ir.rule">
        <field name="name">Vendor Portal: own vendor bill lines</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="domain_force">[
            ('move_id.move_type', 'in', ('in_invoice', 'in_refund', 'in_receipt')),
            ('move_id.state', '=', 'posted'),
            ('move_id.partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])
        ]</field>
        <field name="groups" eval="[(4, ref('group_vendor_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
