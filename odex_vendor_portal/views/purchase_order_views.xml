<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_vendor_portal" model="ir.ui.view">
        <field name="name">purchase.order.form.vendor.portal</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="vendor_portal_responded" invisible="1"/>
                <field name="vendor_response_date" readonly="1"
                       invisible="not vendor_portal_responded"/>
                <field name="vendor_response_note" readonly="1"
                       invisible="not vendor_portal_responded"/>
            </xpath>
        </field>
    </record>

</odoo>
