<odoo>
    <record id="view_estimate_form2_inherit" model="ir.ui.view">
        <field name="name">Estimate form Inherit Job Card Extension</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='show_invoice']" position="before">
                <button class="oe_stat_button" type="object" string="Quotation" name="show_estimate_from_job_card"
                        icon="fa-pencil-square-o" invisible="not is_jobcard" />
            </xpath>
        </field>
    </record>
</odoo>