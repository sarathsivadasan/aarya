<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════
         PAYMENT FORM VIEW (standalone record, not popup)
    ═══════════════════════════════════════════════ -->
    <record id="view_coupon_payment_form" model="ir.ui.view">
        <field name="name">customer.coupon.payment.form</field>
        <field name="model">customer.coupon.payment</field>
        <field name="arch" type="xml">
            <form string="Coupon Payment">
                <header>
                    <button name="action_post" string="Post Payment"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" class="btn-danger"
                            invisible="state not in ('draft','posted')"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group>
                        <group string="Payment Details">
                            <field name="name" readonly="1"/>
                            <field name="coupon_id" readonly="1"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="payment_date" required="1"/>
                            <field name="payment_method" required="1"/>
                            <field name="payment_type" invisible="1"/>
                            <field name="journal_id" required="1"/>
                            <field name="amount" required="1"/>
                            <field name="reference"/>
                        </group>
                        <group string="PDC Details"
                               invisible="payment_method != 'pdc'">
                            <field name="cheque_number"/>
                            <field name="cheque_date"/>
                            <field name="bank_name"/>
                        </group>
                    </group>
                    <group>
                        <field name="move_id" readonly="1"
                               invisible="not move_id"/>
                        <field name="notes" placeholder="Notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════
         PAYMENT LIST VIEW
    ═══════════════════════════════════════════════ -->
    <record id="view_coupon_payment_list" model="ir.ui.view">
        <field name="name">customer.coupon.payment.list</field>
        <field name="model">customer.coupon.payment</field>
        <field name="arch" type="xml">
            <list string="Coupon Payments"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'posted'">
                <field name="name" string="Reference"/>
                <field name="coupon_id" string="Coupon"/>
                <field name="customer_id" string="Customer"/>
                <field name="payment_date" string="Payment Date"/>
                <field name="payment_method" string="Payment Method"
                       widget="badge"
                       decoration-success="payment_method == 'cash'"
                       decoration-info="payment_method == 'bank'"
                       decoration-warning="payment_method == 'pdc'"/>
                <field name="journal_id" string="Journal" optional="show"/>
                <field name="reference" string="Reference" optional="show"/>
                <field name="amount" string="Amount" sum="Total"/>
                <field name="state" string="Status"
                       widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════
         PAYMENT SEARCH VIEW
    ═══════════════════════════════════════════════ -->
    <record id="view_coupon_payment_search" model="ir.ui.view">
        <field name="name">customer.coupon.payment.search</field>
        <field name="model">customer.coupon.payment</field>
        <field name="arch" type="xml">
            <search string="Search Payments">
                <field name="name" string="Reference"/>
                <field name="customer_id" string="Customer"/>
                <field name="coupon_id" string="Coupon"/>
                <separator/>
                <filter string="Draft"  name="filter_draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Posted" name="filter_posted"
                        domain="[('state','=','posted')]"/>
                <separator/>
                <filter string="Cash"   name="filter_cash"
                        domain="[('payment_method','=','cash')]"/>
                <filter string="Bank"   name="filter_bank"
                        domain="[('payment_method','=','bank')]"/>
                <filter string="PDC"    name="filter_pdc"
                        domain="[('payment_method','=','pdc')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer"       name="group_customer"
                            context="{'group_by': 'customer_id'}"/>
                    <filter string="Payment Method" name="group_method"
                            context="{'group_by': 'payment_method'}"/>
                    <filter string="Status"         name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Payment Date"   name="group_date"
                            context="{'group_by': 'payment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════
         PAYMENT ACTION
    ═══════════════════════════════════════════════ -->
    <record id="action_coupon_payments" model="ir.actions.act_window">
        <field name="name">Coupon Payments</field>
        <field name="res_model">customer.coupon.payment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_coupon_payment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No payments found</p>
        </field>
    </record>

</odoo>
