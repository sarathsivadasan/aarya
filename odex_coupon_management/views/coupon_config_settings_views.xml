<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_coupon_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.coupon</field>
        <field name="model">res.config.settings</field>
       <field name="inherit_id" ref="base.res_config_settings_view_form"/>
     <field name="arch" type="xml">
    <xpath expr="//form" position="inside">

        <app string="Coupon Management" name="odex_coupon_management">
            <block title="Coupon Accounting Configuration">

                <setting string="Unearned Revenue Account">
                    <field name="coupon_unearned_revenue_account_id"/>
                </setting>

                <setting string="Coupon Sales Account">
                    <field name="coupon_sales_account_id"/>
                </setting>

                <setting string="PDC Account">
                    <field name="coupon_pdc_account_id"/>
                </setting>
                <setting string="Invoice Account">
                    <field name="coupon_invoice_account_id"/>
                </setting>

                <setting string="Default Journal">
                    <field name="coupon_default_journal_id"/>
                </setting>

                <setting string="VAT Tax">
                    <field name="coupon_vat_tax_id"/>
                </setting>

            </block>
        </app>

    </xpath>
</field>
    </record>

    <!-- Standalone Configuration Action -->
    <record id="action_coupon_config_settings" model="ir.actions.act_window">
        <field name="name">Coupon Configuration</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'odex_coupon_management'}</field>
    </record>

</odoo>
