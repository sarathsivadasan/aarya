<odoo>
      <record id="view_coupon_task_form2_inherit" model="ir.ui.view">
        <field name="name">Entries Task form Inherit Job Card Extension</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority" eval="101"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name = 'button_box']" position="inside">

                <button name="action_view_entries" class="oe_stat_button" icon="fa-bars" type="object"
                        invisible="entries_count == 0">
                    <field name="entries_count" string="Entries" widget="statinfo"/>
                </button>

            </xpath>
        </field>
      </record>
</odoo>