<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_price_visibility" model="ir.ui.view">
        <field name="name">res.users.form.price.visibility</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Product Visibility" name="odex_product_visibility">
                    <group>
                        <field name="context_odex_hide_price"/>
                    </group>
                    <div class="text-muted">
                        Hides the Cost and Sales Price of products from this user in the
                        product list, kanban, form and search views, and blanks those
                        values in the data sent to the browser.
                        The user must log in again, or refresh the browser, for the change
                        to apply.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
