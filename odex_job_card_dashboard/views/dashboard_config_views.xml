<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dashboard_config_form" model="ir.ui.view">
        <field name="name">job.card.dashboard.config.form</field>
        <field name="model">job.card.dashboard.config</field>
        <field name="arch" type="xml">
            <form string="Dashboard Configuration">
                <header>
                    <button name="action_open_stages" type="object"
                            string="Status Cards" class="btn-primary"
                            icon="fa-paint-brush"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Dashboard Configuration"/></h1>
                    </div>
                    <group>
                        <group string="Refresh">
                            <field name="auto_refresh"/>
                            <field name="refresh_interval"
                                   invisible="not auto_refresh"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Data">
                            <field name="default_date_filter"/>
                            <field name="date_field"/>
                            <field name="list_limit"/>
                        </group>
                    </group>
                    <group string="Thresholds">
                        <group>
                            <field name="overdue_warning_days"/>
                            <field name="overdue_critical_days"/>
                            <field name="overdue_severe_days"/>
                        </group>
                        <group>
                            <field name="efficiency_target"/>
                        </group>
                    </group>
                    <group string="Widgets">
                        <group>
                            <field name="show_status_cards"/>
                            <field name="show_bays"/>
                            <field name="show_today_jobs"/>
                            <field name="show_overdue"/>
                        </group>
                        <group>
                            <field name="show_quick_actions"/>
                            <field name="show_waiting"/>
                            <field name="show_alerts"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Changes apply on the next dashboard refresh - no restart
                        and no code change needed.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dashboard_config_list" model="ir.ui.view">
        <field name="name">job.card.dashboard.config.list</field>
        <field name="model">job.card.dashboard.config</field>
        <field name="arch" type="xml">
            <list string="Dashboard Configuration">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="default_date_filter"/>
                <field name="refresh_interval"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_dashboard_config" model="ir.actions.act_window">
        <field name="name">Dashboard Settings</field>
        <field name="res_model">job.card.dashboard.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
