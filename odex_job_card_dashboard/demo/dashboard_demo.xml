<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- A second, inactive profile so the configuration screen can be
             explored without touching the live one. -->
        <record id="dashboard_config_demo_front_desk" model="job.card.dashboard.config">
            <field name="name">Front Desk Profile (demo)</field>
            <field name="active" eval="False"/>
            <field name="auto_refresh" eval="True"/>
            <field name="refresh_interval">15</field>
            <field name="default_date_filter">week</field>
            <field name="date_field">promise_date</field>
            <field name="list_limit">15</field>
            <field name="overdue_warning_days">1</field>
            <field name="overdue_critical_days">2</field>
            <field name="overdue_severe_days">5</field>
            <field name="efficiency_target">85</field>
        </record>

        <!-- Give every existing status a colour and an icon straight away. -->
        <function model="job.card.stage" name="_seed_dashboard_styles"/>

    </data>
</odoo>
