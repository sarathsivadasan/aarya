<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="job_card_extension.OdexOnOffToggle">
        <button type="button" role="switch"
                t-att-aria-checked="value ? 'true' : 'false'"
                t-att-disabled="isReadonly"
                t-att-class="'o_jc_onoff' + (value ? ' o_jc_onoff_on' : '')"
                t-on-click="onClick">
            <span class="o_jc_onoff_label" t-esc="value ? 'ON' : 'OFF'"/>
            <span class="o_jc_onoff_knob"/>
        </button>
    </t>
</templates>
