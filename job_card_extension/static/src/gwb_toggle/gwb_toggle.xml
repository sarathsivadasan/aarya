<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="job_card_extension.GwbToggleField">
        <!-- Miscellaneous items: same green toggle as QC / technician portal (Odoo boolean_toggle) -->
        <div t-if="isYesNo" class="o_gwb_switch_wrap oe_kanban_action" t-on-click.stop="" t-on-mousedown.stop="">
            <CheckBox value="checked"
                      className="'o_field_boolean o_boolean_toggle form-switch'"
                      disabled="props.readonly"
                      onChange.bind="onToggle">&#8203;</CheckBox>
        </div>
        <!-- All other items: G / W / B -->
        <div t-else="" class="o_gwb_toggle oe_kanban_action" t-att-class="{'o_gwb_readonly': props.readonly}" role="radiogroup">
            <t t-foreach="options" t-as="opt" t-key="opt.key">
                <button type="button" role="radio"
                        t-attf-class="o_gwb_btn o_gwb_{{ opt.key }} {{ value === opt.key ? 'o_gwb_active' : '' }}"
                        t-att-aria-label="opt.aria"
                        t-att-aria-checked="value === opt.key ? 'true' : 'false'"
                        t-att-disabled="props.readonly"
                        t-on-mousedown.prevent=""
                        t-on-click.stop="() => this.onSelect(opt.key)">
                    <t t-esc="opt.label"/>
                </button>
            </t>
        </div>
    </t>

    <t t-name="job_card_extension.JcToggleField">
        <div class="o_gwb_switch_wrap oe_kanban_action" t-on-click.stop="" t-on-mousedown.stop="">
            <CheckBox value="checked"
                      className="'o_field_boolean o_boolean_toggle form-switch'"
                      disabled="props.readonly"
                      onChange.bind="onToggle">&#8203;</CheckBox>
        </div>
    </t>
</templates>
