<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="jobcard_advance_payment_view_form" model="ir.ui.view">
            <field name="name">jobcard.advance.payment.wizard</field>
            <field name="model">jobcard.advance.payment.wizard</field>
            <field name="arch" type="xml">
                <form string="Jobcard Advance Payment">
                    <sheet>
                        <field name="id" invisible="1"/>
                        <div class="oe_title">
                            <h1>Jobcard Advance Payment</h1>
                        </div>
                        <group>
                            <group>
                                <field name="job_id" readonly="1"/>
                                <field name="payment_type"/>
                                <field name="partner_type"/>
                                <field name="partner_id"/>
                                <field name="journal_id" widget="selection"/>
                                <field name="hide_payment_method_line" invisible="1"/>
                                <field name="available_payment_method_line_ids" invisible="1"/>
                               <field name="payment_method_line_id"
                                   required="1"  options="{'no_create': True, 'no_open': True}" invisible="hide_payment_method_line"/>   
                            </group>
                            <group>
                                <field name="amount"/>
                                <field name="currency_id" required="1" options="{'no_create': True, 'no_open': True}" groups="base.group_multi_currency"/>
                                <field name="payment_date"/>
                                <field name="bank_reference"/>
                                <field name="communication"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string='Create Payment' name="generate_advance_payment" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Expenses -->
        <record id="jobcard_advance_payment_wizard_action" model="ir.actions.act_window">
            <field name="name">Jobcard Advance Payment</field>
            <field name="res_model">jobcard.advance.payment.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="jobcard_advance_payment_view_form"/>
            <field name="target">new</field>
            <field name="context">{'default_payment_type': 'outbound'}</field>
            <!-- <field name="domain">[('partner_type', '=', 'supplier')]</field> -->
        </record>

</odoo>