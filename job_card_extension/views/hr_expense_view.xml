<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

	<record id="hr_expense_form_view_inherit" model="ir.ui.view">
        <field name="name">hr.expense.view.inherit.form</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
        	<xpath expr="//form/sheet" position="inside">
        		<group>
        			<group name="customer_details" string="Customer Details">
        				<field name="job_id" readonly="1"/>
        				<field name="customer_id"/>
        				<field name="partner_phone"/>
        			</group>
        			<group name="vehicle_details" string="Vehicle Details">
        				<field name="vehicle_id"/>
        				<field name="brand"/>
        				<field name="model_id"/>
        				<field name="vin" string="Chassis No."/>
        				<field name="cylinder_count"/>
        				<field name="vehicle_color" string="Colour"/>
        				<field name="engine"/>
        				<field name="year" string="Year"/>
        			</group>
        		</group>
        	</xpath>
        </field>
    </record>

    <record model="ir.ui.menu" id="hr_expense.menu_hr_expense_root">
        <field name="sequence">10</field>
    </record>

    <record model="ir.ui.menu" id="hr.menu_hr_root">
        <field name="sequence">12</field>
    </record>

</odoo>