<odoo>

    <record id="cc_extend_account_move_form" model="ir.ui.view">
        <field name="name">cc.extend.account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//label[@for='partner_id']" position="before">
                <field name="job_id"/>
            </xpath>
            <xpath expr="//group[@id='header_right_group']" position="after">
                <group name="insurance_details" string="INSURANCE DETAILS">
                    <field name="insurance_company_id"/>
                    <field name="policy_no"/>
                    <field name="lpo_no"/>
                    <field name="lpo_date"/>
                    <field name="claim_no"/>
                </group>
                <group name="vehicle_details" string="VEHICLE DETAILS">
                    <field name="vehicle_id"/>
                    <field name="vehicle_make_id"/>
                    <field name="vehicle_model_id"/>
                    <field name="vin"/>
                    <field name="vehicle_color_id"/>
                    <field name="engin_no"/>
                    <field name="year"/>
                    <field name="odometer"/>
                </group>
            </xpath>
            <xpath expr="//list/field[@name='product_id']" position="before">
                <field name="cost_type"/>
                <field name="parts_type"/>
                <field name="part_no"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_view_inherit" model="ir.ui.view">
        <field name="name">account.out.invoice.list.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_date" position="before">
                <field name="job_id"/>
                <field name="vehicle_id" optional="show"/>
                <field name="vehicle_make_id" optional="show"/>
                <field name="vehicle_model_id" optional="show"/>
                <field name="vehicle_color_id" optional="show"/>
                <field name="year" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_in_invoice_bill_tree_inherit" model="ir.ui.view">
        <field name="name">account.out.invoice.list.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_date" position="before">
                <field name="job_id"/>
                <field name="vehicle_id" optional="show"/>
                <field name="vehicle_make_id" optional="show"/>
                <field name="vehicle_model_id" optional="show"/>
                <field name="vehicle_color_id" optional="show"/>
                <field name="year" optional="show"/>
            </field>
        </field>
    </record>

    <!-- account move lines view -->
    <record id="view_invoice_bill_lines_list" model="ir.ui.view">
        <field name="name">account.move.line.list.invoice.bill.lines</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <list string="Invoice &amp; Bill Lines">
                <field name="move_id" string="Invoice/Bill Number"/>
                <field name="date" string="Date"/>
                <field name="part_no"/>
                <field name="product_id" string="Product"/>
                <field name="quantity" string="Qty"/>
                <field name="product_uom_id" string="UoM"/>
                <field name="price_unit" string="Unit Price"/>
                <field name="price_subtotal" string="Amount" sum="Total Price SubTotal"/>
                <field name="vehicle_id"/>
            </list>
        </field>
    </record>

    <record id="action_invoice_bill_lines" model="ir.actions.act_window">
        <field name="name">Invoice &amp; Bill Lines</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_invoice_bill_lines_list"/>
        <field name="domain">[('move_id.move_type','in',['out_invoice','in_invoice','out_refund','in_refund']),
            ('product_id','!=',False)]
        </field>
    </record>

    <menuitem id="menu_invoice_bill_lines" name="Quick Search Lines"
              web_icon="job_card_extension,static/description/icon.png"/>
    <menuitem id="menu_action_invoice_bill_lines" name="Quick Search Lines" parent="menu_invoice_bill_lines"
              action="action_invoice_bill_lines"/>

    <record model="ir.ui.menu" id="crm.crm_menu_root">
        <field name="sequence">7</field>
    </record>

</odoo>
