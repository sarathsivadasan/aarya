<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="fleet_vehicle_job_inv_form" model="ir.ui.view">
        <field name="name">Vehicle Form Buttons</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[@name='open_assignation_logs']" position="before">
                <button name="action_jobs_list" type="object" class="oe_stat_button" icon="fa-history">
                    <field name="count_job_ids" widget="statinfo" string="Job Orders"/>
                </button>
                <button name="action_invoices_list" type="object" class="oe_stat_button" icon="fa-history">
                    <field name="count_move_ids" widget="statinfo" string="Invoices"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>