<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_branch_form" model="ir.ui.view">
        <field name="name">res.company.branch.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
           <!--  <xpath expr="//field[@name='logo']" position="after">
                <field name="qr_image" widget="image" class="oe_avatar"/>
            </xpath>
            <xpath expr="//field[@name='favicon']" position="after">
                <field name="report_header"/>
            </xpath> -->
            <xpath expr="//page[@name='branches']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_company_branch_tree" model="ir.ui.view">
        <field name="name">res.company.branch.tree.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='child_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
