<odoo>
    <record id="view_move_form_job_card_extension_invoice_line_change" model="ir.ui.view">
        <field name="name">account.move.form - job_card_extension</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="is_job_card_created" invisible="1"/>
                <button name="create_job_cost_sheet_line" string="Create Cost Sheet Line" type="object" class="btn-primary"
                        attrs="{'invisible': [('is_job_card_created', '=', True)]}"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="attributes">
                <attribute name="invisible">1</attribute>

            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='asset_category_id']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="optional">show</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/tree" position="inside">
                <!--<field string="Asset Category" attrs="{'column_invisible': [('parent.move_type', '!=', 'in_invoice')]}"
                       name="asset_category_id" domain="[('type','=','purchase')]"
                       optional="hide"
                       context="{'default_type':'purchase'}"/>-->
                <field name="account_id" options="{'no_open': True}"
                       optional="hide"
                       groups="account.group_account_readonly"/>
                <field name="analytic_account_id"
                       groups="account.group_account_readonly" optional="hide"
                       />
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="before">
                <field name="barcode_custom" width="2"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                <attribute name="width">2</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="attributes">
                <attribute name="string">Cost Price</attribute>
                <attribute name="force_save">1</attribute>
                <attribute name="attrs">{'column_invisible': [('parent.move_type', 'in', ['out_invoice', 'out_refund'])]}</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="before">
                <field name="cloned_price_unit" attrs="{'column_invisible': [('parent.move_type', 'in', ['in_invoice', 'in_refund'])]}"/>
            </xpath>
<!--            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_unit']" position="after">-->
<!--               <button name="action_increase_price" type="object" icon="fa-arrow-up" string="10%" class="btn-link"/>-->
<!--                <field name="profit_loss"/>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='cc_sale_price']" position="attributes">
<!--                <attribute name="string">Cost Price</attribute>-->
                <attribute name="optional">show</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/tree" position="inside">
                <field name="in_stock_quants" invisible="1"/>
                <field name="in_stock_quant" invisible="1"/>
                <field name="in_stock_location_id" optional="hide"/>
                <field name="in_stock_quantity" optional="hide"/>

            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_subtotal']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='l10n_ae_vat_amount']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount_fixed']" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="string">Excess Amount</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="attributes">
                <attribute name="string">Fixed Discount</attribute>
                <attribute name="attrs">{'column_invisible': [('parent.move_type', 'in', ['out_invoice', 'out_refund'])]}</attribute>
            </xpath>
            <field name="insurance_company_id" position="after">
                <field name="title"/>
            </field>
<!--            <field name="partner_id" position="after">-->
<!--                <field name="project_id"/>-->
<!--            </field>-->
        </field>
    </record>

    <!-- Bills Menu in Main Menu -->
    <menuitem id="menu_action_move_in_invoice_type_home" action="account.action_move_in_invoice_type" />

    <record id="view_move_line_tree_extended" model="ir.ui.view">
            <field name="name">account.move.line.tree</field>
            <field name="model">account.move.line</field>
            <field name="arch" type="xml">
                <tree string="Bill Lines" create="false" edit="false">
                    <field name="invoice_date" string="Bill Date"/>
                    <field name="move_id" optional="show" string="Name"/>
                    <field name="task_id" optional="show" string="Job Card"/>
                    <field name="partner_id" string="Vendor"/>
                    <field name="cc_cost_type" optional="show"/>
                    <field name="barcode_custom" optional="show"/>
                    <field name="product_id"/>
                    <field name="name" optional="show"/>
                    <field name="asset_category_id" optional="show"/>
                    <field name="quantity"/>
                    <field name="product_uom_id"/>
<!--                    <field name="vehicle_id"/>-->
                    <field name="register_no"/>
<!--                    <field name="cc_sale_price" string="Cost Price"/>-->
<!--                    <field name="price_unit" string="Sale Price"/>-->
                    <field name="computed_cost_price"/>
                    <field name="total_sale_price"/>
                    <field name="profit_loss"/>
                    <field name="discount_fixed" string="Discount" optional="show"/>
                    <field name="tax_ids" optional="show"/>
                    <field name="l10n_ae_vat_amount" optional="show"/>
                    <field name="price_subtotal" optional="show"/>
                    <field name="currency_id" invisible="1"/>
                </tree>
            </field>
        </record>

    <!-- Bill Lines search view -->
    <record id="bill_lines_view_search" model="ir.ui.view">
        <field name="name">Bill.Lines.view.search</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <search string="Bill Lines">
                <field name="product_id"/>
                <field name="task_id"/>
                <field name="cc_cost_type"/>
                <field name="barcode_custom"/>
                <field name="register_no"/>
                <field name="partner_id" string="Vendor"/>
                <field name="name" string="Bill Number"/>
            </search>
        </field>
    </record>

    <record id="action_account_move_line" model="ir.actions.act_window">
        <field name="name">Bill Lines</field>
        <field name="res_model">account.move.line</field>
        <field name="domain">[('journal_id', '=', 2),('exclude_from_invoice_tab', '=', False)]</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_move_line_tree_extended"/>
        <field name="search_view_id" ref="bill_lines_view_search"/>
    </record>

    <menuitem id="menu_action_move_in_lines"
              name="Bill Lines"
              action="action_account_move_line"
              parent="menu_action_move_in_invoice_type_home" />

    <!--insurance view-->
    <record id="cc_zkauto_extend_account_move_form_inherit" model="ir.ui.view">
        <field name="name">cc.zkauto.extend.account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="excess_amount_insurance.cc_zkauto_extend_account_move_form"/>
        <field name="arch" type="xml">
            <field name="excess_amount" position="attributes">
                <attribute name="attrs">{'invisible': [('move_type', '=', 'in_invoice')]}</attribute>
            </field>
            <field name="partner_excess_amount" position="attributes">
                <attribute name="attrs">{'invisible': [('move_type', '=', 'in_invoice')]}</attribute>
            </field>
            <field name="excess_amount_move_id" position="attributes">
                <attribute name="attrs">{'invisible': [('move_type', '=', 'in_invoice')]}</attribute>
            </field>
            <field name="excess_amount" position="attributes">
                <attribute name="attrs">{'invisible': [('move_type', '=', 'in_invoice')]}</attribute>
            </field>
        </field>
    </record>

</odoo>
