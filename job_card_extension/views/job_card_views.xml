    <record id="view_task_tree2_inherit" model="ir.ui.view">
        <field name="name">project.task.list</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="mode">primary</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="js_class">project_task_list</attribute>
                <attribute name="default_group_by"></attribute>
            </list>
            <field name="stage_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="tag_ids" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="activity_ids" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="name" position="attributes">
                <attribute name="string">Number</attribute>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="optional">show</attribute>
                <attribute name="invisible">0</attribute>
            </field>
            <field name="name" position="before">
                <field name="cc_color" invisible="1" optional="hide"/>
                <field name="cc_stage_id"
                       options='{"bg_color": "
                 #6F4B75:cc_color == 1;
                 #43A047:cc_color == 2;
                 #ECA83E:cc_color == 3;
                 #7E57C2:cc_color == 4;
                 #42A5F5:cc_color == 5;
                 #A13F34:cc_color == 6;
                 #52B87E:cc_color == 7;
                 #B45575:cc_color == 8;
                 #5CA2C4:cc_color == 9;
                 #757575:cc_color == 10;
                 #9A9B9F:cc_color == 11;
                 #BFA10D:cc_color == 12", "fg_color": "white:cc_color > 0"}'/>
            </field>
            <field name="partner_id" position="before">
                <field name="create_date" string="Jobcard Date"/>
            </field>
            <field name="partner_id" position="after">
                <field name="vehicle_id" string="License Plate"/>
                <field name="engine"/>
                <field name="vin" string="Chassis No."/>
                <field name="promise_date"/>
                <field name="used_service_count" readonly="1"/>
<field name="remaining_service_count" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_task_form2_inherited_timesheet" model="ir.ui.view">
