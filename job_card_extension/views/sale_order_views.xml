    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="binding_model_id"></field>
    </record>
    <record id="sale.action_report_pro_forma_invoice" model="ir.actions.report">
        <field name="binding_model_id"></field>
    </record>
    <record id="job_card_extension.action_repair_estimate_report" model="ir.actions.report">
        <field name="binding_model_id"></field>
    </record>
    <record id="job_card_extension.action_proforma_invoice_report" model="ir.actions.report">
        <field name="binding_model_id"></field>
    </record>

    <!-- Product Template filter-->
    <record id="product_template_search_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.search.inherit.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_search_form_view_stock"/>
        <field name="arch" type="xml">
            <field name="location_id" position="before">
                <field name="barcode" string="Part Number" context="{'barcode': self}" filter_domain="[]"/>
            </field>
        </field>
    </record>

    <record id="stock.product_template_action_product" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form</field>
    </record>

    <record id="view_stock_product_template_tree_inherit" model="ir.ui.view">
        <field name="name">product.template.stock.tree.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="qty_available" position="after">
                <field name="product_location_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_template_property_form_inherit" model="ir.ui.view">
        <field name="name">product.template.stock.property.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <field name="detailed_type" position="after">
                <field name="cost_type" required="True"/>
            </field>
            <xpath expr="//group[@name='stock_property']" position="after">
                <group string="Product Locations" name="product_location" groups="base.group_no_one">
                    <field name="product_location_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
