<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_invoice_or_insurance_template">
             <t t-set="is_proforma" t-value="False"/>
            <t t-foreach="docs" t-as="o">
                <t t-call="account.report_invoice"/>

            </t>
        </template>
        <template id="report_proforma_invoice">
            <t t-set="is_proforma" t-value="True"/>

            <t t-foreach="docs" t-as="o">
                <t t-call="account.report_invoice"/>
            </t>
        </template>

        <template id="report_invoice_inherit" inherit_id="account.report_invoice">
            <xpath expr="//t[@t-call='account.report_invoice_document']" position="replace">
                <!-- <t t-call="job_card_extension.report_invoice_document" t-lang="lang"/> -->
                <t t-call="odex_invoice_report_enhance.report_invoice_document_odex"/>
            </xpath>
        </template>

        <template id="report_invoice_document">
            <t t-call="job_card_extension.external_layout">
                <t t-set="o" t-value="o.with_context(lang=lang)"/>
                <t t-set="forced_vat"
                   t-value="o.fiscal_position_id.foreign_vat"/> <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
                <div class="page">
                    <style>
                        td, th, tr {
                        border: none;
                        padding: 5px;
                        }
                        .title {
                        border: 1px solid black;
                        }
                    </style>
                    <div class="row" style="border: 1px solid black;">
                        <table width="100%">
                            <tr style="border: hidden;">
                                <td class="text-center" style="font-size: 20px;">
                                    <b>
                                        <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">
                                            <t t-if="is_proforma">Proforma Invoice</t>
                                            <t t-else="">Invoice</t>
                                        </span>
                                        <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">
                                            <t t-if="is_proforma">Proforma Invoice</t>
                                            <t t-else="">Draft Invoice</t>
                                        </span>
                                        <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled
                                            Invoice
                                        </span>
                                        <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                                        <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                                        <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                                        <!--                                    <span t-if="o.name != '/'" t-field="o.name"/>-->
                                    </b>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="row">
                        <div class="col-6"
                             style="border: 1px solid black;  border-right: 0px;">
                            <table width="100%">
                                <tr>
                                    <td style="width: 83px;" class="text-left">
                                        <b>Invoice No.</b>
                                    </td>
                                    <td style="width: 7px;" class="text-left">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 220px;" class="text-left">
                                        <span t-field="o.name"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-6"
                             style="border: 1px solid black;  border-left: 0px;">
                            <table width="100%">
                                <tr>
                                    <td style="width: 130px;" class="text-left">
                                        <b>Invoice Date</b>
                                    </td>
                                    <td style="width: 7px;" class="text-center">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 150px;" class="text-left">
                                        <span t-field="o.invoice_date"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6" style="border: 1px solid black;">
                            <table style="width: 100%;color: #212529;padding-top: 0px;">
                                <tr>
                                    <td style="width: 25px;">
                                        <b>Name</b>
                                    </td>
                                    <td style="width: 5px;" class="text-left">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 160px;" class="text-left">
                                        <span t-esc="o.job_id.partner_id.name or o.partner_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 25px;">
                                        <b>Address</b>
                                    </td>
                                    <td style="width: 5px;" class="text-left">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 150px;">
                                        <t t-if="o.job_id.partner_id.street">
                                            <span t-field="o.job_id.partner_id.street"/>,
                                        </t>
                                        <t t-if="o.job_id.partner_id.street2">
                                            <span t-field="o.job_id.partner_id.street2"/>,
                                        </t>
                                        <t t-if="o.job_id.partner_id.city">
                                            <span t-field="o.job_id.partner_id.city"/>,
                                        </t>
                                        <t t-if="o.job_id.partner_id.state_id"><span
                                                t-field="o.job_id.partner_id.state_id.name"/>,
                                        </t>
                                        <t t-if="o.job_id.partner_id.zip">
                                            <span t-field="o.job_id.partner_id.zip"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 25px;">
                                        <b>Contact No.</b>
                                    </td>
                                    <td style="width: 5px;" class="text-left">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 150px;">
                                        <span t-field="o.job_id.partner_id.phone"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 25px;">
                                        <b>Email</b>
                                    </td>
                                    <td style="width: 5px;" class="text-left">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 150px;">
                                        <span t-field="o.job_id.partner_id.email"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 25px;">
                                        <b>TRN #</b>
                                    </td>
                                    <td style="width: 5px;" class="text-left">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 150px;">
                                        <span t-field="o.partner_id.vat"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-6" style="border : 1px solid black;">
                            <table style="width: 100%;color: #212529; padding-top: 0px;">
                                <tr>
                                    <td style="width: 150px;" class="text-left">
                                        <b>Job Number</b>
                                    </td>
                                    <td style="width: 7px;" class="text-center">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 150px;" class="text-left">
                                        <span t-field="o.job_id"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 150px;" class="text-left">
                                        <b>Reg No.</b>
                                    </td>
                                    <td style="width: 7px;" class="text-center">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 150px;" class="text-left">
                                        <span t-field="o.vehicle_id"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 150px;" class="text-left">
                                        <b>Make &amp; Model</b>
                                    </td>
                                    <td style="width: 7px;" class="text-center">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 150px;" class="text-left">
                                        <span t-field="o.vehicle_make_id.name"/>
                                        /
                                        <span t-field="o.vehicle_model_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 150px;" class="text-left">
                                        <b>VIN No.</b>
                                    </td>
                                    <td style="width: 7px;" class="text-center">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 150px;" class="text-left">
                                        <span t-field="o.vin"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 150px;" class="text-left">
                                        <b>Odometer</b>
                                    </td>
                                    <td style="width: 7px;" class="text-center">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 150px;" class="text-left">
                                        <span t-field="o.odometer"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 150px;" class="text-left">
                                        <b>Year</b>
                                    </td>
                                    <td style="width: 7px;" class="text-center">
                                        <b>:</b>
                                    </td>
                                    <td style="width: 150px;" class="text-left">
                                        <span t-field="o.year"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <t t-set="display_discount" t-value="any(l.discount for l in o.invoice_line_ids)"/>
                    <t t-set="total_discount" t-value="0"/>
                    <t t-set="line_total_amount" t-value="0"/>
                    <t t-set="total_vat" t-value="0"/>

                    <!-- Cost Sheet Lines -->
                    <div class="row">
                        <style>
                            .inv-table tr td { padding: 0px 3px 0px 3px !important;}
                            .inv-table tr th { padding: 0px 3px 0px 3px !important;}
                        </style>
                        <table class="inv-table" width="100%" style="border: 1px solid black;">
                            <tr style="border: 1px solid black;">
                                <!--                                <th>Sr.No.</th>-->
                                <th style="border-right: 1px solid black; width: 50%;">Description</th>
                                <th style="border-right: 1px solid black;" class="text-right">Rate</th>
                                <th style="border-right: 1px solid black;" class="text-right">Qty</th>
                                <th style="border-right: 1px solid black;" class="text-right">Amount</th>
                                <th style="border-right: 1px solid black;" class="text-right">
                                    <t t-if="o.amount_tax">VAT 5%</t>
                                    <t t-else="">VAT 0%</t>
                                </th>
                                <th t-if="display_discount" style="border-right: 1px solid black;" class="text-right">
                                    Discount
                                </th>
                                <th style="border-right: 1px solid black;" class="text-right">Total</th>
                            </tr>
                            <tbody>
                                <t t-foreach="o.separate_invoice_lines()" t-as="invoice_cost_sheet_lines">
                                    <t t-foreach="invoice_cost_sheet_lines" t-as="invoice_cost_sheet_line">
                                        <t t-set="count" t-value="0"/>
                                        <t t-foreach="invoice_cost_sheet_line" t-as="cost_sheet_line">
                                            <t t-set="total_discount"
                                               t-value="cost_sheet_line.discount + total_discount"/>
                                            <t t-set="line_total_amount"
                                               t-value="cost_sheet_line.price_subtotal + line_total_amount"/>
                                            <t t-set="total_vat"
                                               t-value="cost_sheet_line.l10n_ae_vat_amount + total_vat"/>
                                            <tr>
                                                <t t-set="count" t-value="count + 1"/>
                                                <td class="text-left"
                                                    style="width: 50%; border-right: 1px solid black;">
                                                    <span t-field="cost_sheet_line.name"/>
                                                </td>
                                                <td style="border-right: 1px solid black;" class="text-right">
                                                    <span t-field="cost_sheet_line.price_unit"/>
                                                </td>
                                                <td style="border-right: 1px solid black;" class="text-right">
                                                    <span t-field="cost_sheet_line.quantity"/>
                                                </td>
                                                <td style="border-right: 1px solid black;" class="text-right">
                                                    <span t-esc="'%.2f'%cost_sheet_line.price_subtotal"/>
                                                </td>
                                                <td style="border-right: 1px solid black;" class="text-right">
                                                    <span t-esc="'%.2f'%cost_sheet_line.l10n_ae_vat_amount"/>
                                                </td>
                                                <td t-if="display_discount" style="border-right: 1px solid black;"
                                                    class="text-right">
                                                    <span t-field="cost_sheet_line.discount"/>
                                                </td>
                                                <td class="text-right" style="border-right: 1px solid black;">
                                                    <t t-set="taxed_total"
                                                       t-value="cost_sheet_line.price_subtotal + cost_sheet_line.l10n_ae_vat_amount"/>
                                                    <span t-esc="'%.2f'%taxed_total"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                                <tr>
                                    <td width="50%"
                                        style="border-right: 1px solid black; border-bottom: 1px solid black;">
                                        <br/>
                                    </td>
                                    <td style="border-right: 1px solid black; border-bottom: 1px solid black;">
                                        <br/>
                                    </td>
                                    <td style="border-right: 1px solid black; border-bottom: 1px solid black;">
                                        <br/>
                                    </td>
                                    <td style="border-right: 1px solid black; border-bottom: 1px solid black;">
                                        <br/>
                                    </td>
                                    <td t-if="display_discount"
                                        style="border-right: 1px solid black; border-bottom: 1px solid black;">
                                        <br/>
                                    </td>
                                    <td style="border-right: 1px solid black; border-bottom: 1px solid black;">
                                        <br/>
                                    </td>
                                    <td style="border-right: 1px solid black; border-bottom: 1px solid black;">
                                        <br/>
                                    </td>
                                </tr>
                                <tr>
                                    <t t-set="payments_vals"
                                       t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                                    <t t-if="payments_vals">
                                        <t t-set="i" t-value="5"/>
                                        <t t-foreach="payments_vals" t-as="payment_vals">
                                            <t t-set="i" t-value="i+1"/>
                                        </t>
                                        <td t-att-rowspan="i"
                                            style="border-right: 1px solid black; width: 50%; border-bottom: 1px solid black;"/>
                                    </t>
                                    <t t-else="">
                                        <td rowspan="5"
                                            style="border-right: 1px solid black; width: 50%; border-bottom: 1px solid black;"/>
                                    </t>
                                    <td colspan="4"
                                        style="border-right: 1px solid black; border-bottom: 1px solid black;">Gross
                                        Amount
                                    </td>
                                    <td style="border-right: 1px solid black; border-bottom: 1px solid black;"
                                        class="text-right">
                                        <t t-esc="'%.2f'%line_total_amount"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="4"
                                        style="border-right: 1px solid black; border-bottom: 1px solid black;">
                                        <t t-if="o.amount_tax">VAT 5%</t>
                                        <t t-else="">VAT 0%</t>
                                    </td>
                                    <td style="border-right: 1px solid black; border-bottom: 1px solid black;"
                                        class="text-right">
                                        <t t-esc="'%.2f'%total_vat"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="4"
                                        style="border-right: 1px solid black; border-bottom: 1px solid black;">
                                        <b>Net
                                            Amount (AED)
                                        </b>
                                    </td>
                                    <td style="border-right: 1px solid black; border-bottom: 1px solid black;"
                                        class="text-right">
                                        <b>
                                            <t t-esc="'%.2f'%(line_total_amount + total_vat)"/>
                                        </b>
                                    </td>
                                </tr>
                                <tr>
                                    <t t-foreach="payments_vals" t-as="payment_vals">
                                        <tr>
                                            <td colspan="4"
                                                style="border-right: 1px solid black; border-bottom: 1px solid black;">
                                                <span style="font-style: italic;">
                                                    <i class="oe_form_field text-right oe_payment_label">Paid on
                                                        <t t-esc="payment_vals['date']"
                                                           t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                                                    </i>
                                                </span>
                                            </td>
                                            <td class="text-right"
                                                style="border-right: 1px solid black; border-bottom: 1px solid black;">
                                                <span t-esc="payment_vals['amount']"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tr>
                                <tr>
                                    <td colspan="4"
                                        style="border-right: 1px solid black; border-bottom: 1px solid black;">
                                        <b>
                                            <span style="font-style: italic;">Amount Due</span>
                                        </b>
                                    </td>
                                    <td style="border-right: 1px solid black; border-bottom: 1px solid black;"
                                        class="text-right">
                                        <b>
                                            <t t-esc="'%.2f'%(o.amount_residual)"/>
                                        </b>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="7 if display_discount else 6" style="border-bottom: 1px solid black;">
                                        <p style="margin-left: 5px; margin-top: 5px;">
                                            <b>Amount In Words:</b>
                                            <span t-esc="o.write_num2words(o.amount_total) + ' ONLY'"/>
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="7 if display_discount else 6" style="border-bottom: 1px solid black;">
                                        <p style="margin-left: 5px; display:inline;">
                                            <b>Concerns &amp; Job Description:</b>
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="7 if display_discount else 6" style="border-bottom: 1px solid black;">
                                        <p style="margin-left: 5px; display:inline;">
                                            <b>Remarks:</b>
                                        </p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="row"
                         style="border-left: 1px solid black; border-bottom: 1px solid black; border-right: 1px solid black;">
                        <div class="col-4">
                            <table>
                                <tr style="border-right: hidden;">
                                    <td>
                                        <p>
                                            <br/>
                                        </p>
                                    </td>
                                </tr>
                                <tr style="border-right: hidden;">
                                    <td>
                                        <p>
                                            <br/>
                                        </p>
                                    </td>
                                </tr>
                                <tr style="border-right: hidden">
                                    <td class="text-center">_________________________________</td>
                                </tr>
                                <tr style="border-right: hidden;">
                                    <td class="text-center">Company Sign and Stamp</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-4">
                            <table>
                                <tr style="border-right: hidden; border-left: hidden;">
                                    <td>
                                        <p>
                                            <br/>
                                        </p>
                                    </td>
                                </tr>
                                <tr style="border-right: hidden; border-left: hidden;">
                                    <td>
                                        <p>
                                            <br/>
                                        </p>
                                    </td>
                                </tr>
                                <tr style="border-right: hidden; border-left: hidden;">
                                    <td class="text-center">________
                                        <t t-if="o.job_id"
                                           t-esc=" o.job_id.user_ids[0].name if o.job_id.user_ids else o.invoice_user_id.name"/>
                                        ________
                                    </td>
                                </tr>
                                <tr style="border-right: hidden; border-left: hidden;">
                                    <td class="text-center">Prepared By</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-4">
                            <table>
                                <tr style="border-right: hidden; border-left: hidden;">
                                    <td>
                                        <p>
                                            <br/>
                                        </p>
                                    </td>
                                </tr>
                                <tr style="border-right: hidden; border-left: hidden;">
                                    <td>
                                        <p>
                                            <br/>
                                        </p>
                                    </td>
                                </tr>
                                <tr style="border-right: hidden; border-left: hidden;">
                                    <td class="text-center">_________________________________</td>
                                </tr>
                                <tr style="border-right: hidden; border-left: hidden;">
                                    <td class="text-center">Customer Signature</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>

