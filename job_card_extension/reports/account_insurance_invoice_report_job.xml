                                        <!--                                                        <td>-->
                                        <!--                                                            <strong>Amount Due</strong>-->
                                        <!--                                                        </td>-->
                                        <!--                                                        <td class="text-right">-->
                                        <!--                                                            <span t-field="o.amount_residual"/>-->
                                        <!--                                                        </td>-->
                                        <!--                                                    </tr>-->
                                        <!--                                                </t>-->
                                        <!--                                            </t>-->
                                        <!--                                        </t>-->
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>