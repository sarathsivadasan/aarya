<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odex_garage_technician_portal.DashboardPage">
        <div class="o_tp_dashboard">
            <div class="o_tp_cards_row">
                <div class="o_tp_card">
                    <div class="o_tp_card_icon bg-blue"><i class="fa fa-clipboard"/></div>
                    <div>
                        <div class="o_tp_card_label">Assigned Total</div>
                        <div class="o_tp_card_value" t-esc="state.counters.assigned"/>
                        <a href="#" class="o_tp_card_link"
                           t-on-click.prevent="() => this.viewAll('not_started')">View All</a>
                    </div>
                </div>
                <div class="o_tp_card">
                    <div class="o_tp_card_icon bg-orange"><i class="fa fa-play"/></div>
                    <div>
                        <div class="o_tp_card_label">In Progress</div>
                        <div class="o_tp_card_value" t-esc="state.counters.in_progress"/>
                        <a href="#" class="o_tp_card_link"
                           t-on-click.prevent="() => this.viewAll('running')">View All</a>
                    </div>
                </div>
                <div class="o_tp_card">
                    <div class="o_tp_card_icon bg-yellow"><i class="fa fa-pause"/></div>
                    <div>
                        <div class="o_tp_card_label">Paused</div>
                        <div class="o_tp_card_value" t-esc="state.counters.paused"/>
                        <a href="#" class="o_tp_card_link"
                           t-on-click.prevent="() => this.viewAll('paused')">View All</a>
                    </div>
                </div>
                <div class="o_tp_card">
                    <div class="o_tp_card_icon bg-green"><i class="fa fa-check"/></div>
                    <div>
                        <div class="o_tp_card_label">Completed Today</div>
                        <div class="o_tp_card_value" t-esc="state.counters.completed_today"/>
                        <a href="#" class="o_tp_card_link"
                           t-on-click.prevent="() => this.viewAll('completed')">View All</a>
                    </div>
                </div>
                <div class="o_tp_card">
                    <div class="o_tp_card_icon bg-purple"><i class="fa fa-clock-o"/></div>
                    <div>
                        <div class="o_tp_card_label">Total Hours Today</div>
                        <div class="o_tp_card_value" t-esc="state.counters.hours_today"/>
                        <a href="#" class="o_tp_card_link"
                           t-on-click.prevent="() => this.viewAll(null, 'performance')">View Timesheet</a>
                    </div>
                </div>
            </div>

            <div class="o_tp_recent">
                <div class="o_tp_recent_header">
                    <h3>My Work</h3>
                    <a href="#" t-on-click.prevent="() => this.viewAll(null)">View All</a>
                </div>
                <div class="o_tp_inspection_list">
                    <div t-foreach="state.recent" t-as="item" t-key="item.id"
                         class="o_tp_inspection_row" t-on-click="() => this.openTask(item.id, item.record_type)">
                        <div class="o_tp_row_left">
                            <a href="#" class="o_tp_row_code" t-esc="item.task_name"/>
                            <span t-attf-class="badge o_tp_priority_#{item.priority_label}"
                                  t-esc="item.priority_label"/>
                        </div>
                        <div class="o_tp_row_vehicle" t-esc="item.vehicle"/>
                        <div class="o_tp_row_bottom">
                            <span t-esc="item.customer"/>
                            <span t-attf-class="badge o_tp_status_#{item.status}"
                                  t-esc="item.status"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
