<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odex_garage_technician_portal.ComplaintsTab">
        <div class="o_tp_complaints_tab">
            <table class="table">
                <thead>
                    <tr>
                        <th>Service</th><th>Instruction</th>
                        <th>Assign Hours</th><th>Assignees</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="state.lines" t-as="line" t-key="line.id">
                        <td t-esc="line.product"/>
                        <td class="text-muted" t-esc="line.remark || '-'"/>
                        <td t-esc="line.assign_hours.toFixed(2)"/>
                        <td>
                            <t t-if="line.assignees.length">
                                <div t-foreach="line.assignees" t-as="a" t-key="a_index"
                                     class="o_tp_assignee_chip">
                                    <span t-esc="a.name"/>
                                    <span class="text-muted"><t t-esc="a.hours.toFixed(2)"/>h</span>
                                </div>
                            </t>
                            <span t-else="" class="text-muted">Not assigned</span>
                        </td>
                    </tr>
                    <tr t-if="!state.lines.length">
                        <td colspan="4" class="text-muted">No services requested for this job.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>
</templates>
