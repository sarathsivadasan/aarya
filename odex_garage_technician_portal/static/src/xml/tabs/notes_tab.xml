<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odex_garage_technician_portal.NotesTab">
        <div class="o_tp_notes_tab">
            <div class="o_tp_note_composer">
                <textarea class="form-control" rows="3" placeholder="Add a note..."
                          t-model="state.draft"/>
                <button class="btn btn-primary btn-sm" t-on-click="addNote">Add Note</button>
            </div>
            <div t-foreach="state.notes" t-as="note" t-key="note.id" class="o_tp_note_item">
                <div class="o_tp_note_meta">
                    <strong t-esc="note.user"/> <span t-esc="note.date"/>
                </div>
                <div class="o_tp_note_content" t-out="note.content"/>
            </div>
        </div>
    </t>
</templates>
