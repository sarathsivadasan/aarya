<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- v5.0.0: was action_report_vehicle_inspection ("Vehicle Inspection
         Report"). Renamed with the removal of Vehicle Inspection support;
         it prints the technician work on a Job Card. -->
    <record id="action_report_technician_job" model="ir.actions.report">
        <field name="name">Job Card Work Report</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odex_garage_technician_portal.report_technician_job</field>
        <field name="report_file">odex_garage_technician_portal.report_technician_job</field>
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Job Card - %s' % (object.number or object.name)</field>
    </record>
</odoo>
