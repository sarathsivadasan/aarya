<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 18 settings use the app/block/setting tag structure, not the
         pre-18 div.settings/app_settings_block xpath target. -->
    <record id="res_config_settings_view_form_technician" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.technician.portal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Technician Portal" name="odex_garage_technician_portal"
                     groups="odex_garage_technician_portal.group_garage_technician_supervisor">
                    <block title="Job Tracking" name="technician_job_tracking">
                        <setting string="Late Job Threshold (Hours)"
                                 help="Extra hours of grace past the promise date before a job is flagged 'Late' on the Performance page.">
                            <field name="technician_late_job_threshold"/>
                        </setting>
                    </block>
                    <block title="Parts" name="technician_parts">
                        <setting string="Job Card / Inspection Link Field"
                                 help="Technical name of the many2one on project.task that links a Job Card to the Vehicle Inspection it came from, e.g. 'inspection_id'. Part information entered in the Parts tab is kept in step across that link. Leave empty to detect it automatically.">
                            <field name="technician_part_link_field"
                                   placeholder="auto-detect"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
