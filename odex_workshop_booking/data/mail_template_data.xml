    <record id="mail_template_booking_cancelled" model="mail.template">
        <field name="name">Booking: Cancelled</field>
        <field name="model_id" ref="model_odex_workshop_booking"/>
        <field name="subject">Booking Cancelled - {{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.partner_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.email or object.partner_id.email }}</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:24px;background:#f4f6fb;font-family:Arial,Helvetica,sans-serif;">
  <div style="max-width:560px;margin:auto;background:#ffffff;border-radius:14px;overflow:hidden;box-shadow:0 4px 16px rgba(15,40,90,.08);">
    <div style="background:#dc2626;padding:28px 32px;color:#fff;">
      <h2 style="margin:0;font-size:20px;">Booking Cancelled</h2>
      <p style="margin:6px 0 0;opacity:.9;font-size:13px;">Reference <strong t-out="object.name"/></p>
    </div>
    <div style="padding:28px 32px;color:#31435c;font-size:14px;line-height:1.6;">
      <p>Dear <t t-out="object.partner_id.name"/>,</p>
      <p>Your workshop appointment on
        <strong t-out="format_date(object.booking_date)"/> at
        <strong t-out="object.time_label"/> has been cancelled.</p>
      <p>You are welcome to book a new appointment at any time on our website.</p>
    </div>
  </div>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
