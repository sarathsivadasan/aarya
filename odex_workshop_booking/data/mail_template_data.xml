<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="mail_template_booking_confirmation" model="mail.template">
        <field name="name">Booking: Confirmation</field>
        <field name="model_id" ref="model_odex_workshop_booking"/>
        <field name="subject">Booking Confirmed - {{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.partner_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.email or object.partner_id.email }}</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:24px;background:#f4f6fb;font-family:Arial,Helvetica,sans-serif;">
  <div style="max-width:560px;margin:auto;background:#ffffff;border-radius:14px;overflow:hidden;box-shadow:0 4px 16px rgba(15,40,90,.08);">
    <div style="background:#1a56db;padding:28px 32px;color:#fff;">
      <h2 style="margin:0;font-size:20px;">Booking Confirmed ✔</h2>
      <p style="margin:6px 0 0;opacity:.85;font-size:13px;">Reference <strong t-out="object.name"/></p>
    </div>
    <div style="padding:28px 32px;color:#31435c;font-size:14px;line-height:1.6;">
      <p>Dear <t t-out="object.partner_id.name"/>,</p>
      <p>Your workshop appointment has been confirmed. Here are the details:</p>
      <table style="width:100%;border-collapse:collapse;font-size:14px;">
        <tr><td style="padding:6px 0;color:#7a8aa3;">Date</td><td style="padding:6px 0;text-align:right;font-weight:bold;" t-out="format_date(object.booking_date)"/></tr>
        <tr><td style="padding:6px 0;color:#7a8aa3;">Time</td><td style="padding:6px 0;text-align:right;font-weight:bold;" t-out="object.time_label"/></tr>
        <tr><td style="padding:6px 0;color:#7a8aa3;">Workshop</td><td style="padding:6px 0;text-align:right;font-weight:bold;" t-out="object.company_id.name"/></tr>
        <tr><td style="padding:6px 0;color:#7a8aa3;">Vehicle</td><td style="padding:6px 0;text-align:right;font-weight:bold;" t-out="object.vehicle_id.display_name"/></tr>
        <tr><td style="padding:6px 0;color:#7a8aa3;">Service</td><td style="padding:6px 0;text-align:right;font-weight:bold;" t-out="object.service_type_id.name"/></tr>
      </table>
      <p style="margin-top:20px;">Please arrive 10 minutes before your slot. You can view, reschedule or cancel this booking from your customer portal.</p>
      <p style="margin-top:24px;color:#7a8aa3;font-size:12px;">Thank you,<br/><t t-out="object.company_id.name"/> · <t t-out="object.company_id.phone or ''"/></p>
    </div>
  </div>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="mail_template_booking_reminder" model="mail.template">
        <field name="name">Booking: Reminder</field>
        <field name="model_id" ref="model_odex_workshop_booking"/>
        <field name="subject">Reminder: Workshop Appointment Tomorrow - {{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.partner_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.email or object.partner_id.email }}</field>
        <field name="body_html" type="html">
<div style="margin:0;padding:24px;background:#f4f6fb;font-family:Arial,Helvetica,sans-serif;">
  <div style="max-width:560px;margin:auto;background:#ffffff;border-radius:14px;overflow:hidden;box-shadow:0 4px 16px rgba(15,40,90,.08);">
    <div style="background:#d97706;padding:28px 32px;color:#fff;">
      <h2 style="margin:0;font-size:20px;">Appointment Reminder ⏰</h2>
      <p style="margin:6px 0 0;opacity:.9;font-size:13px;">Reference <strong t-out="object.name"/></p>
    </div>
    <div style="padding:28px 32px;color:#31435c;font-size:14px;line-height:1.6;">
      <p>Dear <t t-out="object.partner_id.name"/>,</p>
      <p>This is a friendly reminder of your workshop appointment tomorrow:</p>
      <p style="font-size:16px;font-weight:bold;margin:12px 0;">
        <t t-out="format_date(object.booking_date)"/> · <t t-out="object.time_label"/><br/>
        <span style="font-weight:normal;color:#7a8aa3;" t-out="object.company_id.name"/>
      </p>
      <p>Vehicle: <strong t-out="object.vehicle_id.display_name"/><br/>
         Service: <strong t-out="object.service_type_id.name"/></p>
      <p style="margin-top:20px;">If you can no longer make it, please reschedule or cancel from your customer portal.</p>
    </div>
  </div>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="mail_template_booking_rescheduled" model="mail.template">
