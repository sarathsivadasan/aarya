<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_form_inherit_booking" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.booking</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_bookings" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o">
                    <field name="booking_count" widget="statinfo" string="Bookings"/>
                </button>
            </div>
            <field name="vin_sn" position="after">
                <field name="engine_number"/>
                <field name="cylinder_count"/>
            </field>
        </field>
    </record>

    <record id="res_partner_form_inherit_booking" model="ir.ui.view">
        <field name="name">res.partner.form.booking</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_workshop_bookings" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o">
                    <field name="workshop_booking_count" widget="statinfo" string="Bookings"/>
                </button>
            </div>
            <page name="internal_notes" position="before">
                <page string="Vehicles" name="workshop_vehicles">
                    <field name="workshop_vehicle_ids" readonly="1">
                        <list>
                            <field name="display_name" string="Vehicle"/>
                            <field name="license_plate"/>
                            <field name="vin_sn"/>
                            <field name="model_year"/>
                            <field name="color"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>
</odoo>
