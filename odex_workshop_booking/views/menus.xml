<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_booking_dashboard" model="ir.actions.client">
        <field name="name">Booking Dashboard</field>
        <field name="tag">odex_booking_dashboard</field>
    </record>

    <menuitem id="menu_booking_root" name="Booking"
              web_icon="odex_workshop_booking,static/description/icon.png"
              sequence="35"
              groups="odex_workshop_booking.group_booking_user"/>

    <menuitem id="menu_booking_dashboard" name="Dashboard"
              parent="menu_booking_root" action="action_booking_dashboard" sequence="1"/>

    <menuitem id="menu_booking_bookings" name="Bookings"
              parent="menu_booking_root" sequence="5"/>
    <menuitem id="menu_booking_all" name="All Bookings"
              parent="menu_booking_bookings" action="action_workshop_booking" sequence="1"/>
    <menuitem id="menu_booking_today" name="Today's Bookings"
              parent="menu_booking_bookings" action="action_workshop_booking_today" sequence="2"/>

    <menuitem id="menu_booking_calendar" name="Calendar"
              parent="menu_booking_root" action="action_workshop_booking_calendar" sequence="10"/>

    <!-- One entry, no submenu: the working schedule is the only
         availability configuration there is. -->
    <menuitem id="menu_booking_slots" name="Working Schedule"
              parent="menu_booking_root" sequence="15"
              action="action_booking_schedule_default"
              groups="odex_workshop_booking.group_booking_manager"/>

    <menuitem id="menu_booking_reschedule" name="Reschedule Requests"
              parent="menu_booking_root" action="action_booking_reschedule" sequence="20"/>

    <menuitem id="menu_booking_reports" name="Reports"
              parent="menu_booking_root" sequence="25"/>
    <menuitem id="menu_booking_acquisition" name="Customer Acquisition"
              parent="menu_booking_reports" action="action_booking_acquisition" sequence="20"/>
    <menuitem id="menu_booking_report_analysis" name="Booking Analysis"
              parent="menu_booking_reports" action="action_booking_report" sequence="1"/>

    <menuitem id="menu_booking_config" name="Configuration"
              parent="menu_booking_root" sequence="90"
              groups="odex_workshop_booking.group_booking_manager"/>
    <menuitem id="menu_booking_config_company" name="Workshop Locations"
              parent="menu_booking_config" action="action_booking_company" sequence="1"/>
    <menuitem id="menu_booking_location" name="Pickup &amp; Drop Locations"
              parent="menu_booking_config" action="action_booking_location" sequence="2"/>
    <menuitem id="menu_booking_config_service" name="Service Types"
              parent="menu_booking_config" action="action_booking_service_type" sequence="2"/>
    <menuitem id="menu_booking_config_holiday" name="Holidays &amp; Closures"
              parent="menu_booking_config" action="action_booking_holiday" sequence="3"/>
    <menuitem id="menu_booking_config_settings" name="Settings"
              parent="menu_booking_config" action="action_booking_settings" sequence="99"/>
</odoo>
