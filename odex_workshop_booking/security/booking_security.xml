<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_booking" model="ir.module.category">
        <field name="name">Booking</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_booking_user" model="res.groups">
        <field name="name">Service Advisor</field>
        <field name="category_id" ref="module_category_booking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_booking_manager" model="res.groups">
        <field name="name">Workshop Manager</field>
        <field name="category_id" ref="module_category_booking"/>
        <field name="implied_ids" eval="[(4, ref('group_booking_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Portal customers: only their own bookings -->
    <record id="rule_booking_portal" model="ir.rule">
        <field name="name">Booking: portal users see own bookings</field>
        <field name="model_id" ref="model_odex_workshop_booking"/>
        <field name="domain_force">[('partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_booking_company" model="ir.rule">
        <field name="name">Booking: multi-company</field>
        <field name="model_id" ref="model_odex_workshop_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="rule_slot_company" model="ir.rule">
        <field name="name">Booking Slot: multi-company</field>
        <field name="model_id" ref="model_odex_booking_slot"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="rule_schedule_company" model="ir.rule">
        <field name="name">Working Schedule: multi-company</field>
        <field name="model_id" ref="model_odex_booking_schedule"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
    </record>

    <record id="rule_reschedule_portal" model="ir.rule">
        <field name="name">Reschedule: portal users see own requests</field>
        <field name="model_id" ref="model_odex_booking_reschedule"/>
        <field name="domain_force">[('partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Portal users may READ only the vehicles they own, and only the
         locations published for the website. Nothing else in Fleet is
         exposed: no write, no create, no unlink, and no other customer's
         vehicle can ever match the domain. -->
    <record id="rule_vehicle_portal" model="ir.rule">
        <field name="name">Fleet Vehicle: portal customer sees own vehicles</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            ['|', ('driver_id', '=', user.partner_id.id),
                  ('driver_id', 'child_of', user.partner_id.commercial_partner_id.id)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_vehicle_model_portal" model="ir.rule">
        <field name="name">Fleet Model: portal read</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle_model"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_location_portal" model="ir.rule">
        <field name="name">Booking Location: portal reads published only</field>
        <field name="model_id" ref="model_odex_booking_location"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('website_published', '=', True)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
