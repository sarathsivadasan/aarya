<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odex_pc_return_list" model="ir.ui.view">
        <field name="name">odex.pc.return.list</field>
        <field name="model">odex.petty.cash.return</field>
        <field name="arch" type="xml">
            <list string="Cash Returns"
                  decoration-success="state == 'posted'"
                  decoration-info="state == 'approved'"
                  decoration-warning="state == 'submitted'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state in ('cancelled','draft')">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="reason" optional="show"/>
                <field name="approved_by" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state in ('approved','posted')"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state in ('cancelled','draft')"/>
                <button name="action_approve" string="✓ Approve" type="object"
                        icon="fa-check" class="btn-success btn-sm"
                        invisible="state != 'submitted'"
                        groups="odex_petty_cash.group_petty_cash_manager"/>
            </list>
        </field>
    </record>

    <record id="view_odex_pc_return_form" model="ir.ui.view">
        <field name="name">odex.pc.return.form</field>
        <field name="model">odex.petty.cash.return</field>
        <field name="arch" type="xml">
            <form string="Cash Return">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-success" invisible="state != 'submitted'"
                            groups="odex_petty_cash.group_petty_cash_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ('submitted','approved')"
                            groups="odex_petty_cash.group_petty_cash_manager"/>
                    <button name="action_post" string="Post" type="object"
                            class="btn-primary" invisible="state != 'approved'"
                            groups="odex_petty_cash.group_petty_cash_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('posted','cancelled')"
                            groups="odex_petty_cash.group_petty_cash_finance_admin"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('rejected','cancelled')"
                            groups="odex_petty_cash.group_petty_cash_finance_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="petty_cash_account_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Approval Trail" invisible="state == 'draft'">
                        <group>
                            <field name="submitted_by" readonly="1"/>
                            <field name="submitted_date" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="rejected_by" readonly="1" invisible="state != 'rejected'"/>
                            <field name="rejection_reason" readonly="1" invisible="state != 'rejected'"/>
                            <field name="posted_by" readonly="1" invisible="state != 'posted'"/>
                            <field name="posted_date" readonly="1" invisible="state != 'posted'"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Reason for returning cash..." readonly="state != 'draft'"/>
                    <field name="attachment_ids" widget="many2many_binary"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_odex_pc_return" model="ir.actions.act_window">
        <field name="name">Cash Returns</field>
        <field name="res_model">odex.petty.cash.return</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_odex_pc_return_pending" model="ir.actions.act_window">
        <field name="name">Pending Returns</field>
        <field name="res_model">odex.petty.cash.return</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','submitted')]</field>
    </record>
</odoo>
