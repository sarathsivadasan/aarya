<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- ── Transaction List ─────────────────────────────────────────── -->
    <record id="view_odex_pc_txn_list" model="ir.ui.view">
        <field name="name">odex.pc.txn.list</field>
        <field name="model">odex.petty.cash.transaction</field>
        <field name="arch" type="xml">
            <list string="Transactions"
                  decoration-success="state == 'posted'"
                  decoration-info="state == 'approved'"
                  decoration-warning="state == 'submitted'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state in ['cancelled', 'draft']">
                <field name="date"/>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="transaction_type" widget="badge"
                       decoration-success="transaction_type == 'income'"
                       decoration-danger="transaction_type == 'expense'"/>
                <field name="category_id"/>
                <field name="description"/>
                <field name="partner_id" optional="show" string="Vendor"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="submitted_by" optional="hide"/>
                <field name="approved_by" optional="show" string="Approved By"/>
                <field name="approved_date" optional="hide" string="Approved On"/>
                <field name="rejected_by" optional="hide"/>
                <field name="rejection_reason" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'submitted'"
                       decoration-success="state in ['approved', 'posted']"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state in ['cancelled', 'draft']"/>
                <button name="action_approve" string="Approve" type="object"
                        icon="fa-check" class="btn-success btn-sm"
                        invisible="state != 'submitted'"
                        groups="odex_petty_cash.group_petty_cash_manager"/>
                <button name="action_reject" string="Reject" type="object"
                        icon="fa-times" class="btn-danger btn-sm"
                        invisible="state != 'submitted'"
                        groups="odex_petty_cash.group_petty_cash_manager"/>
            </list>
        </field>
    </record>

    <!-- ── Transaction Form ─────────────────────────────────────────── -->
    <record id="view_odex_pc_txn_form" model="ir.ui.view">
        <field name="name">odex.pc.txn.form</field>
        <field name="model">odex.petty.cash.transaction</field>
        <field name="arch" type="xml">
            <form string="Petty Cash Transaction">
                <header>
                    <button name="action_submit" string="Submit for Approval"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-success" invisible="state != 'submitted'"
                            groups="odex_petty_cash.group_petty_cash_manager"/>
                    <button name="action_approve_override"
                            string="Approve (Override Balance)" type="object"
                            class="btn-warning"
                            invisible="state != 'submitted'"
                            groups="odex_petty_cash.group_petty_cash_finance_admin"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ['submitted', 'approved']"
                            groups="odex_petty_cash.group_petty_cash_manager"/>
                    <button name="action_send_back" string="Send Back" type="object"
                            invisible="state not in ['submitted', 'approved']"
                            groups="odex_petty_cash.group_petty_cash_manager"/>
                    <button name="action_post" string="Post / Pay" type="object"
                            class="btn-primary" invisible="state != 'approved'"
                            groups="odex_petty_cash.group_petty_cash_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['posted', 'cancelled']"
                            groups="odex_petty_cash.group_petty_cash_finance_admin"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ['rejected', 'cancelled']"
                            groups="odex_petty_cash.group_petty_cash_finance_admin"/>
                    <button name="action_view_journal_entry" string="Journal Entry"
                            type="object" class="btn-secondary" invisible="not move_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,posted"/>
                </header>
                <sheet>
                    <field name="move_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_journal_entry" type="object"
                                class="oe_stat_button" icon="fa-bars" invisible="not move_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Over-balance rejection banner -->
                    <div class="alert alert-danger" role="alert"
                         invisible="state != 'rejected' or not rejection_reason">
                        <strong>Rejected:</strong>
                        <field name="rejection_reason" readonly="1" nolabel="1"/>
                    </div>

                    <group>
                        <group string="Transaction">
                            <field name="transaction_type" widget="radio" readonly="state != 'draft'"/>
                            <field name="petty_cash_account_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="partner_id" string="Vendor / Payee"
                                   readonly="state != 'draft'" options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Details">
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="category_id" invisible="transaction_type == 'income'"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="received_by" invisible="transaction_type == 'expense'"
                                   readonly="state != 'draft'"/>
                            <field name="description" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- GL Journal Entry Preview -->
                    <group string="Journal Entry Preview" invisible="not petty_cash_account_id">
                        <field name="gl_warning_msg" invisible="1"/>
                        <div colspan="2" class="alert alert-warning" role="alert"
                             invisible="not gl_warning_msg">
                            <field name="gl_warning_msg" readonly="1" nolabel="1"/>
                        </div>
                        <div colspan="2" invisible="gl_warning_msg">
                            <table style="width:100%;border-collapse:collapse;font-size:13px;">
                                <thead>
                                    <tr style="background:#f5f3ef;">
                                        <th style="padding:7px 12px;border-bottom:1px solid #ddd;">Account</th>
                                        <th style="padding:7px 12px;border-bottom:1px solid #ddd;color:#888;font-size:11px;">Role</th>
                                        <th style="padding:7px 12px;text-align:right;border-bottom:1px solid #ddd;color:#17a75a;">Debit</th>
                                        <th style="padding:7px 12px;text-align:right;border-bottom:1px solid #ddd;color:#e0403e;">Credit</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="padding:7px 12px;">
                                            <field name="effective_debit_account_id" readonly="1" nolabel="1"/>
                                        </td>
                                        <td style="padding:7px 12px;color:#888;font-size:11px;">Debit</td>
                                        <td style="padding:7px 12px;text-align:right;color:#17a75a;font-weight:600;">
                                            <field name="amount" readonly="1" nolabel="1"/>
                                        </td>
                                        <td style="padding:7px 12px;text-align:right;color:#aaa;">—</td>
                                    </tr>
                                    <tr>
                                        <td style="padding:7px 12px;">
                                            <field name="effective_credit_account_id" readonly="1" nolabel="1"/>
                                        </td>
                                        <td style="padding:7px 12px;color:#888;font-size:11px;">Credit</td>
                                        <td style="padding:7px 12px;text-align:right;color:#aaa;">—</td>
                                        <td style="padding:7px 12px;text-align:right;color:#e0403e;font-weight:600;">
                                            <field name="amount" readonly="1" nolabel="1"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div style="font-size:11px;color:#aaa;margin-top:5px;padding-left:12px;">
                                Entry is created when you click <b>Post / Pay</b>.
                            </div>
                        </div>
                    </group>

                    <!-- Balance at time of approval -->
                    <group string="Balance Snapshot" invisible="not balance_before">
                        <group>
                            <field name="balance_before" readonly="1" string="Balance Before Approval"/>
                            <field name="balance_after" readonly="1" string="Balance After Posting"/>
                        </group>
                    </group>

                    <!-- Approval trail -->
                    <group string="Approval Trail" invisible="state == 'draft'">
                        <group>
                            <field name="submitted_by" readonly="1"/>
                            <field name="submitted_date" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="rejected_by" readonly="1" invisible="state != 'rejected'"/>
                            <field name="rejected_date" readonly="1" invisible="state != 'rejected'"/>
                            <field name="posted_by" readonly="1" invisible="state != 'posted'"/>
                            <field name="posted_date" readonly="1" invisible="state != 'posted'"/>
                        </group>
                    </group>

                    <field name="attachment_ids" widget="many2many_binary"
                           readonly="state != 'draft'" string="Receipt / Attachments"/>
                    <field name="note" placeholder="Notes..." readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search ───────────────────────────────────────────────────── -->
    <record id="view_odex_pc_txn_search" model="ir.ui.view">
        <field name="name">odex.pc.txn.search</field>
        <field name="model">odex.petty.cash.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Reference"/>
                <field name="description"/>
                <field name="employee_id"/>
                <field name="category_id"/>
                <field name="partner_id" string="Vendor"/>
                <separator/>
                <filter string="My Expenses" name="my_expenses"
                        domain="[('user_id','=',uid),('transaction_type','=','expense')]"/>
                <filter string="Pending My Approval" name="pending_my_approval"
                        domain="[('petty_cash_manager_user_id','=',uid),('state','=','submitted')]"/>
                <separator/>
                <filter string="Expense" name="expense" domain="[('transaction_type','=','expense')]"/>
                <filter string="Income" name="income" domain="[('transaction_type','=','income')]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Posted / Paid" name="posted" domain="[('state','=','posted')]"/>
                <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('date','&gt;=',(context_today()+relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_by_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Category" name="group_by_category" context="{'group_by':'category_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by':'state'}"/>
                    <filter string="Type" name="group_by_type" context="{'group_by':'transaction_type'}"/>
                    <filter string="Month" name="group_by_month" context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Actions ──────────────────────────────────────────────────── -->
    <record id="action_odex_pc_my_expenses" model="ir.actions.act_window">
        <field name="name">My Expenses</field>
        <field name="res_model">odex.petty.cash.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('transaction_type','=','expense')]</field>
        <field name="context">{'default_transaction_type': 'expense', 'search_default_my_expenses': 1}</field>
    </record>
    <record id="action_odex_pc_txn_pending" model="ir.actions.act_window">
        <field name="name">Pending Approvals</field>
        <field name="res_model">odex.petty.cash.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','submitted')]</field>
        <field name="context">{'search_default_pending_my_approval': 1}</field>
    </record>
    <record id="action_odex_pc_txn_all" model="ir.actions.act_window">
        <field name="name">All Transactions</field>
        <field name="res_model">odex.petty.cash.transaction</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>