<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_odex_pc_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            body{font-family:Arial,sans-serif;font-size:12px;}
                            h2{color:#3b3480;text-align:center;margin-bottom:2px;}
                            .sub{text-align:center;color:#666;font-size:11px;margin-bottom:14px;}
                            .cards{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;}
                            .card{flex:1;min-width:90px;border:1px solid #e0ddd8;border-radius:4px;padding:8px 10px;text-align:center;}
                            .cl{font-size:9px;color:#888;text-transform:uppercase;}
                            .cv{font-size:14px;font-weight:700;}
                            .green{color:#17a75a;}.red{color:#e0403e;}.orange{color:#e65100;}.blue{color:#1a6fa0;}
                            .sec{font-size:11px;font-weight:700;padding:5px 8px;border-left:3px solid;margin-bottom:0;}
                            .sec-alloc{color:#1a6fa0;border-color:#1a6fa0;background:#e8f4fd;}
                            .sec-exp{color:#e0403e;border-color:#e0403e;background:#fff5f5;}
                            .sec-ret{color:#666;border-color:#ccc;background:#f5f5f5;}
                            table{width:100%;border-collapse:collapse;font-size:10px;margin-bottom:12px;}
                            th{background:#f5f3ef;padding:4px 7px;text-align:left;border-bottom:1px solid #ddd;text-transform:uppercase;font-size:9px;}
                            td{padding:4px 7px;border-bottom:1px solid #f0ede8;}
                            .tr{text-align:right;}
                            .total-row td{font-weight:700;background:#f5f3ef;border-top:1px solid #ddd;}
                            .bal-box{background:#f0faf5;border:1px solid #17a75a;border-radius:4px;padding:8px 12px;display:flex;justify-content:space-between;margin-top:8px;}
                            .badge{display:inline-block;padding:1px 6px;border-radius:8px;font-size:9px;font-weight:600;}
                            .b-posted{background:#d4edda;color:#155724;}
                            .b-approved{background:#cce5ff;color:#004085;}
                            .b-pending{background:#fff3cd;color:#856404;}
                            .b-rejected{background:#f8d7da;color:#721c24;}
                        </style>

                        <h2>ODEX Petty Cash Statement</h2>
                        <div class="sub">
                            <b>Employee:</b> <t t-esc="doc.petty_cash_account_id.employee_id.name"/> |
                            <b>Account:</b> <t t-esc="doc.petty_cash_account_id.name"/> |
                            <b>Period:</b> <t t-esc="doc.date_from"/> to <t t-esc="doc.date_to"/>
                        </div>

                        <!-- Summary Cards -->
                        <div class="cards">
                            <div class="card"><div class="cl">Opening</div><div class="cv"><t t-esc="doc.petty_cash_account_id.currency_id.symbol"/><t t-esc="'%.2f' % doc.opening_balance"/></div></div>
                            <div class="card"><div class="cl">Received</div><div class="cv green"><t t-esc="doc.petty_cash_account_id.currency_id.symbol"/><t t-esc="'%.2f' % doc.total_received"/></div></div>
                            <div class="card"><div class="cl">Spent</div><div class="cv red"><t t-esc="doc.petty_cash_account_id.currency_id.symbol"/><t t-esc="'%.2f' % doc.total_spent"/></div></div>
                            <div class="card"><div class="cl">Pending</div><div class="cv orange"><t t-esc="doc.petty_cash_account_id.currency_id.symbol"/><t t-esc="'%.2f' % doc.total_pending"/></div></div>
                            <div class="card"><div class="cl">Returned</div><div class="cv"><t t-esc="doc.petty_cash_account_id.currency_id.symbol"/><t t-esc="'%.2f' % doc.total_returned"/></div></div>
                            <div class="card" style="background:#f0faf5;border-color:#17a75a;"><div class="cl">Available</div><div class="cv green"><t t-esc="doc.petty_cash_account_id.currency_id.symbol"/><t t-esc="'%.2f' % doc.available_balance"/></div></div>
                        </div>

                        <!-- Cash Allocations Received -->
                        <t t-set="allocs" t-value="doc.petty_cash_account_id.allocation_ids.filtered(lambda a: a.state == 'posted' and a.date &gt;= doc.date_from and a.date &lt;= doc.date_to).sorted('date')"/>
                        <div class="sec sec-alloc">Cash Received (Allocations) — Total: <t t-esc="doc.petty_cash_account_id.currency_id.symbol"/><t t-esc="'%.2f' % sum(allocs.mapped('amount'))"/></div>
                        <table>
                            <thead><tr><th>Date</th><th>Reference</th><th>Payment Method</th><th>Notes</th><th>Issued By</th><th class="tr">Amount</th></tr></thead>
                            <tbody>
                                <t t-foreach="allocs" t-as="a">
                                    <tr><td><t t-esc="a.date"/></td><td><t t-esc="a.name"/></td><td><t t-esc="dict(a._fields['payment_method'].selection).get(a.payment_method,'')"/></td><td><t t-esc="a.notes or ''"/></td><td><t t-esc="a.approved_by.name or ''"/></td><td class="tr green"><t t-esc="'%.2f' % a.amount"/></td></tr>
                                </t>
                                <tr class="total-row"><td colspan="5" class="tr">Total Received</td><td class="tr green"><t t-esc="doc.petty_cash_account_id.currency_id.symbol"/><t t-esc="'%.2f' % sum(allocs.mapped('amount'))"/></td></tr>
                            </tbody>
                        </table>

                        <!-- Posted Expenses -->
                        <t t-set="exps" t-value="doc.petty_cash_account_id.transaction_ids.filtered(lambda t: t.state == 'posted' and t.transaction_type == 'expense' and t.date &gt;= doc.date_from and t.date &lt;= doc.date_to).sorted('date')"/>
                        <div class="sec sec-exp">Expenses (Posted / Paid) — Total: <t t-esc="doc.petty_cash_account_id.currency_id.symbol"/><t t-esc="'%.2f' % sum(exps.mapped('amount'))"/></div>
                        <table>
                            <thead><tr><th>Date</th><th>Reference</th><th>Category</th><th>Description</th><th>Vendor</th><th>Approved By</th><th class="tr">Amount</th></tr></thead>
                            <tbody>
                                <t t-foreach="exps" t-as="e">
                                    <tr><td><t t-esc="e.date"/></td><td><t t-esc="e.name"/></td><td><t t-esc="e.category_id.name or ''"/></td><td><t t-esc="e.description"/></td><td><t t-esc="e.partner_id.name or ''"/></td><td><t t-esc="e.approved_by.name or ''"/></td><td class="tr red"><t t-esc="'%.2f' % e.amount"/></td></tr>
                                </t>
                                <tr class="total-row"><td colspan="6" class="tr">Total Spent</td><td class="tr red"><t t-esc="doc.petty_cash_account_id.currency_id.symbol"/><t t-esc="'%.2f' % sum(exps.mapped('amount'))"/></td></tr>
                            </tbody>
                        </table>

                        <!-- Pending Expenses -->
                        <t t-set="pending" t-value="doc.petty_cash_account_id.transaction_ids.filtered(lambda t: t.state in ('submitted','approved') and t.transaction_type == 'expense' and t.date &gt;= doc.date_from and t.date &lt;= doc.date_to).sorted('date')"/>
                        <t t-if="pending">
                            <div class="sec" style="color:#e65100;border-color:#e65100;background:#fff8e1;">Pending Approval (not yet deducted) — Total: <t t-esc="doc.petty_cash_account_id.currency_id.symbol"/><t t-esc="'%.2f' % sum(pending.mapped('amount'))"/></div>
                            <table>
                                <thead><tr><th>Date</th><th>Reference</th><th>Category</th><th>Description</th><th>Status</th><th class="tr">Amount</th></tr></thead>
                                <tbody>
                                    <t t-foreach="pending" t-as="p">
                                        <tr><td><t t-esc="p.date"/></td><td><t t-esc="p.name"/></td><td><t t-esc="p.category_id.name or ''"/></td><td><t t-esc="p.description"/></td><td><span t-attf-class="badge #{p.state == 'approved' and 'b-approved' or 'b-pending'}"><t t-esc="p.state.title()"/></span></td><td class="tr orange"><t t-esc="'%.2f' % p.amount"/></td></tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- Available Balance -->
                        <div class="bal-box">
                            <span style="font-weight:700;color:#17a75a;font-size:12px;">Available Petty Cash Balance</span>
                            <span style="font-weight:700;color:#17a75a;font-size:17px;"><t t-esc="doc.petty_cash_account_id.currency_id.symbol"/><t t-esc="'%.2f' % doc.available_balance"/></span>
                        </div>
                        <div style="font-size:10px;color:#aaa;margin-top:4px;text-align:center;">
                            Balance = Opening + Received − Spent (posted only) − Returned. Pending expenses not deducted.
                        </div>

                        <div style="margin-top:20px;display:flex;justify-content:space-between;font-size:10px;color:#aaa;">
                            <span>Printed: <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/></span>
                            <span>ODEX Petty Cash | Odoo 18 Community</span>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
