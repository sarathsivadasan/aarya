<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_alloc" model="ir.sequence">
            <field name="name">ODEX PC Allocation</field>
            <field name="code">odex.petty.cash.allocation</field>
            <field name="prefix">PCA/%(year)s/</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_income" model="ir.sequence">
            <field name="name">ODEX PC Income</field>
            <field name="code">odex.petty.cash.income</field>
            <field name="prefix">PCR/%(year)s/</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_expense" model="ir.sequence">
            <field name="name">ODEX PC Expense</field>
            <field name="code">odex.petty.cash.expense</field>
            <field name="prefix">PCE/%(year)s/</field>
            <field name="padding">4</field>
        </record>
        <record id="seq_return" model="ir.sequence">
            <field name="name">ODEX PC Return</field>
            <field name="code">odex.petty.cash.return</field>
            <field name="prefix">PCT/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <record id="cat_stationery" model="odex.petty.cash.category"><field name="name">Stationery</field><field name="sequence">10</field></record>
        <record id="cat_transport" model="odex.petty.cash.category"><field name="name">Transport</field><field name="sequence">20</field></record>
        <record id="cat_refreshment" model="odex.petty.cash.category"><field name="name">Refreshment</field><field name="sequence">30</field></record>
        <record id="cat_printing" model="odex.petty.cash.category"><field name="name">Printing</field><field name="sequence">40</field></record>
        <record id="cat_bank_charges" model="odex.petty.cash.category"><field name="name">Bank Charges</field><field name="sequence">50</field></record>
        <record id="cat_general" model="odex.petty.cash.category"><field name="name">General Expenses</field><field name="sequence">60</field></record>
        <record id="cat_misc" model="odex.petty.cash.category"><field name="name">Miscellaneous</field><field name="sequence">70</field></record>
        <record id="cat_utilities" model="odex.petty.cash.category"><field name="name">Utilities</field><field name="sequence">80</field></record>
        <record id="cat_repairs" model="odex.petty.cash.category"><field name="name">Repairs &amp; Maintenance</field><field name="sequence">90</field></record>
        <record id="cat_medical" model="odex.petty.cash.category"><field name="name">Medical</field><field name="sequence">100</field></record>
        <record id="cat_communication" model="odex.petty.cash.category"><field name="name">Communication</field><field name="sequence">110</field></record>
        <record id="cat_entertainment" model="odex.petty.cash.category"><field name="name">Entertainment</field><field name="sequence">120</field></record>
    </data>
</odoo>
