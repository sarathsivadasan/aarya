<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<!--	Vat report form view-->
		<record id="vat_return_report_view_form" model="ir.ui.view">
			<field name="name">vat.return.report.view.form</field>
			<field name="model">account.vat.report</field>
			<field name="arch" type="xml">
				<form string="UAE VAT 201">
					<group>
						<group>
							<field name="from_date" required="1" />
							<field name="name" invisible="1"/>
						</group>
						<group>
							<field name="to_date" required="1" />
						</group>
					</group>
					<footer>
						<button name="generate_xlsx_report"
                            string="Download"
                            type="object" class="btn-primary" />
						<button string="Cancel" class="oe_link" special="cancel" />
					</footer>
				</form>
			</field>
		</record>
<!--	   Vat report action-->
		<record id="action_vat_report" model="ir.actions.act_window">
			<field name="name">UAE Vat 201</field>
			<field name="res_model">account.vat.report</field>
			<field name="type">ir.actions.act_window</field>
			<field name="view_mode">form</field>
			<field name="view_id" ref="vat_return_report_view_form"/>
			<field name="context">{}</field>
			<field name="target">new</field>
		</record>
<!--        Vat report menu-->
		<menuitem action="action_vat_report" 
					id="menu_vat_report" 
					parent="account.account_reports_management_menu" 
					sequence="25" />
</odoo>
