<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Complete page of the purchase_order -->
    <template
        id="purchase_order_portal_template"
        name="Purchase Order Portal Template"
        inherit_id="portal.portal_sidebar"
        primary="True"
    >
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t
                t-set="o_portal_fullwidth_alert"
                groups="purchase.group_purchase_manager"
            >
                <t t-call="portal.portal_back_in_edit_mode" />
            </t>

            <div class="row mt-3 o_portal_purchase_sidebar">
                <!-- Sidebar -->
                <t t-call="portal.portal_record_sidebar">
                    <t t-set="classes" t-value="'d-print-none col-lg-3 col-xl-4'" />

                    <t t-set="title">
                        <h2
                            t-field="purchase_order.amount_total"
                            data-id="total_amount"
                        />
                    </t>
                    <t t-set="entries">
                        <div class="d-flex flex-column gap-4">
                            <div
                                class="d-flex flex-column gap-2"
                                id="purchase_order_sidebar_button"
                            >
                                <a
                                    t-if="purchase_order._has_to_be_signed()"
                                    role="button"
                                    class="btn btn-primary d-block"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalaccept"
                                    href="#"
                                >
                                    <i class="fa fa-check" />Sign &amp; Send
                                </a>
                                <div
                                    class="o_download_pdf d-flex gap-1 flex-lg-column flex-xl-row"
                                >
                                    <div class="flex-grow-1">
                                        <a
                                            class="btn btn-secondary o_print_btn o_portal_invoice_print d-block"
                                            t-att-href="purchase_order.get_portal_url(report_type='pdf')"
                                            id="print_invoice_report"
                                            title="View Details"
                                            target="_blank"
                                        ><i class="fa fa-print" /> View Details</a>
                                    </div>
                                </div>
                                <div
                                    class="o_download_pdf d-flex gap-1 flex-lg-column flex-xl-row"
                                >
                                    <div class="flex-grow-1">
                                        <a
                                            class="btn btn-secondary o_print_btn o_portal_invoice_print d-block"
                                            t-att-href="purchase_order.get_portal_url(report_type='pdf', download=True)"
                                            id="download_invoice_report"
                                            title="View Details"
                                            target="_blank"
                                        ><i class="fa fa-download" /> Download</a>
                                    </div>
                                </div>
                            </div>

                            <div
                                class="navspy flex-grow-1 ps-0"
                                t-ignore="true"
                                role="complementary"
                            >
                                <ul class="nav flex-column bs-sidenav" />
                            </div>

                            <div t-if="purchase_order.user_id">
                                <h6><small class="text-muted">Your contact</small></h6>
                                <div
                                    class="o_portal_contact_details d-flex flex-column gap-2"
                                >
                                    <div
                                        class="d-flex justify-content-start align-items-center gap-2"
                                    >
                                        <img
                                            class="o_avatar o_portal_contact_img rounded"
                                            t-att-src="image_data_uri(purchase_order.user_id.avatar_1024)"
                                            alt="Contact"
                                        />
                                        <div>
                                            <h6
                                                class="mb-0"
                                                t-out="purchase_order.user_id.name"
                                            />
                                            <a
                                                href="#discussion"
                                                class="d-flex align-items-center gap-2 small fw-bold"
                                            >
                                            Send message
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>

                <!-- Page content -->
                <div id="quote_content" class="col-12 col-lg-9 col-xl-8 mt-5 mt-lg-0">

                    <!-- modal relative to the actions sign and pay -->
                    <div role="dialog" class="modal fade" id="modalaccept">
                        <div class="modal-dialog">
                            <form
                                id="accept"
                                method="POST"
                                t-att-data-order-id="purchase_order.id"
                                t-att-data-token="purchase_order.access_token"
                                class="js_accept_json modal-content js_website_submit_form"
                            >
                                <input
                                    type="hidden"
                                    name="csrf_token"
                                    t-att-value="request.csrf_token()"
                                />
                                <header class="modal-header">
                                    <h4 class="modal-title">Send quotation</h4>
                                    <button
                                        type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Close"
                                    />
                                </header>
                                <main class="modal-body" id="sign-dialog">
                                    <p>
                                        <span
                                        >By signing this quotation, I agree to the following terms:</span>
                                        <ul>
                                            <li><span>On the behalf of:</span> <b
                                                    t-field="purchase_order.partner_id.commercial_partner_id"
                                                /></li>
                                            <li><span>For an amount of:</span> <b
                                                    data-id="total_amount"
                                                    t-field="purchase_order.amount_total"
                                                /></li>
                                            <li
                                                t-if="purchase_order.payment_term_id"
                                            ><span>With payment terms:</span> <b
                                                    t-field="purchase_order.payment_term_id"
                                                /></li>
                                        </ul>
                                    </p>
                                    <t t-call="portal.signature_form">
                                        <t
                                            t-set="call_url"
                                            t-value="purchase_order.get_portal_url(suffix='/accept')"
                                        />
                                        <t
                                            t-set="default_name"
                                            t-value="purchase_order.partner_id.name"
                                        />
                                    </t>
                                </main>
                            </form>
                        </div>
                    </div>

                    <!-- modal relative to the action reject -->
                    <div role="dialog" class="modal fade" id="modaldecline">
                        <div class="modal-dialog">
                            <form
                                id="decline"
                                method="POST"
                                t-attf-action="/my/purchase/#{purchase_order.id}/decline?access_token=#{purchase_order.access_token}"
                                class="modal-content"
                            >
                                <input
                                    type="hidden"
                                    name="csrf_token"
                                    t-att-value="request.csrf_token()"
                                />
                                <header class="modal-header">
                                    <h4 class="modal-title">Reject This Quotation</h4>
                                    <button
                                        type="button"
                                        class="btn-close"
                                        data-bs-dismiss="modal"
                                        aria-label="Close"
                                    />
                                </header>
                                <main class="modal-body">
                                    <p>
                                        Tell us why you are refusing from sending this quotation, this will help us improve ourselves.
                                    </p>
                                    <textarea
                                        rows="4"
                                        name="decline_message"
                                        required=""
                                        placeholder="Your feedback..."
                                        class="form-control"
                                    />
                                </main>
                                <footer class="modal-footer">
                                    <button
                                        type="submit"
                                        t-att-id="purchase_order.id"
                                        class="btn btn-danger"
                                    ><i class="fa fa-times" /> Reject</button>
                                    <button
                                        type="button"
                                        class="btn btn-primary"
                                        data-bs-dismiss="modal"
                                    >Cancel</button>
                                </footer>
                            </form>
                        </div>
                    </div>

                    <!-- status messages -->
                    <div
                        t-if="message == 'sign_ok'"
                        class="alert alert-success alert-dismissible d-print-none"
                        role="status"
                    >
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="close"
                        />
                        <strong>Thank You!</strong><br />
                        <t
                            t-if="message == 'sign_ok'"
                        >You have sent this quotation successfully.</t>
                        <t t-else="">Your order has been signed.</t>
                    </div>

                    <div
                        t-if="message == 'cant_reject'"
                        class="alert alert-danger alert-dismissible d-print-none"
                        role="alert"
                    >
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="close"
                        />
                        Your order is not in a state to be rejected.
                    </div>

                    <div
                        t-if="purchase_order.state == 'cancel'"
                        class="alert alert-danger alert-dismissible d-print-none"
                        role="alert"
                    >
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="close"
                        />
                        <strong>This quotation has been canceled.</strong> <a
                            role="button"
                            href="#discussion"
                        ><i
                                class="fa fa-comment"
                            /> Contact us to get more information.</a>
                    </div>
                    <div
                        t-if="message == 'cant_sign'"
                        class="alert alert-danger alert-dismissible d-print-none"
                        role="alert"
                    >
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="close"
                        />
                        <strong>This quotation has been proceeded.</strong> <a
                            role="button"
                            href="#discussion"
                        ><i
                                class="fa fa-comment"
                            /> Contact us to get more information.</a>
                    </div>
                    <!-- main content -->
                    <div t-attf-class="#{'pb-5' if report_type == 'html' else ''}">
                        <div
                            t-call="purchase_rfq_online.purchase_order_portal_content"
                        />
                    </div>

                    <!-- bottom actions -->
                    <div
                        class="row justify-content-center text-center d-print-none pt-1 pb-4"
                    >
                        <div
                            t-if="purchase_order.state in ('draft', 'sent') and not purchase_order.signed_on"
                            class="col-sm-auto mt8"
                        >
                            <a
                                role="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#modalaccept"
                                href="#"
                            ><i class="fa fa-check" /> Sign &amp; Send </a>
                        </div>
                        <div class="col-sm-auto mt8">
                            <a
                                role="button"
                                class="btn btn-secondary"
                                href="#discussion"
                            ><i class="fa fa-comment" /> Feedback</a>
                        </div>
                        <div
                            t-if="purchase_order.state in ('draft', 'sent') and not purchase_order.signed_on"
                            class="col-sm-auto mt8"
                        >
                            <a
                                role="button"
                                class="btn btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#modaldecline"
                                href="#"
                            > <i class="fa fa-times" /> Reject</a>
                        </div>
                    </div>

                    <!-- chatter -->
                    <div id="purchase_order_communication" class="mt-4">
                        <h2>History</h2>
                        <t t-call="portal.message_thread">
                            <t t-set="object" t-value="purchase_order" />
                        </t>
                    </div>
                </div><!-- // #quote_content -->
            </div>
        </xpath>
    </template>

    <!--
    Purchase Order content : intro, informations, order lines, remarks, descriptions ....
    This template should contains all the printable element of the PO. This is the
    template rendered in PDF with the report engine.
    -->
    <template id="purchase_order_portal_content" name="Purchase Order Portal Content">
        <!-- Intro -->
        <div
            id="introduction"
            t-attf-class="pb-2 pt-3 #{'card-header bg-white' if report_type == 'html' else ''}"
        >
          <h2 class="my-0">
                <t t-esc="purchase_order.type_name" />
                <em t-esc="purchase_order.name" />
            </h2>
        </div>

        <div t-attf-class="#{'card-body' if report_type == 'html' else ''}">
            <!-- Informations -->
            <div id="informations">
                <div class="row" id="po_date">
                    <div class="mb-3 col-6">
                      <t t-if="purchase_order.state in ['draft', 'sent']">
                        <strong>Quotation Date:</strong>
                      </t>
                      <t
                            t-if="purchase_order.state in ['purchase', 'done', 'cancel', 'to approve']"
                        >
                        <strong>Order Date:</strong>
                      </t>
                      <span
                            t-field="purchase_order.date_order"
                            t-options='{"widget": "date"}'
                        />
                    </div>
                    <div class="mb-3 col-6" t-if="purchase_order.date_planned">
                        <strong>Receipt Date:</strong> <span
                            t-field="purchase_order.date_planned"
                            t-options='{"widget": "date"}'
                        />
                    </div>
                </div>
            </div>

            <section id="details" style="page-break-inside: auto;" class="mt32">
                <h3 id="details">Pricing</h3>
                <table class="table table-sm" id="purchase_order_table">
                    <thead class="bg-100">
                        <tr>
                            <th class="text-left" id="th_vendor_part_no">VPart No.</th>
                            <th class="text-left">Products</th>
                            <th class="text-right">Quantity</th>
                            <th
                                t-attf-class="text-right {{ 'd-none d-sm-table-cell' if report_type == 'html' else '' }}"
                            >Unit Price</th>
                            <th
                                t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"
                            >
                                <span>Taxes</span>
                            </th>
                            <th class="text-end">
                                <span>Amount</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="purchase_tbody">

                        <t t-set="current_subtotal" t-value="0" />

                        <t t-foreach="purchase_order.order_line" t-as="line">

                            <t
                                t-set="current_subtotal"
                                t-value="current_subtotal + line.price_subtotal"
                            />

                            <tr
                                t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''"
                            >
                                <t t-if="not line.display_type">
                                    <td id="vendor_part_no" class="text-left">
                                        <t t-if="purchase_order._has_to_be_signed()">
                                            <input
                                                type="text"
                                                class="js_po_line_vendor_part_no form-control d-print-none"
                                                style="min-width: 110px;"
                                                t-att-data-id="line.id"
                                                t-att-value="line.vendor_part_no or ''"
                                                t-att-maxlength="vendor_part_no_max_length"
                                                placeholder="VPart No."
                                                aria-label="Vendor Part Number"
                                            />
                                            <span
                                                class="d-none d-print-inline"
                                                t-out="line.vendor_part_no or ''"
                                            />
                                        </t>
                                        <span
                                            t-else=""
                                            t-out="line.vendor_part_no or ''"
                                        />
                                    </td>
                                    <td id="product_name"><span
                                            t-field="line.name"
                                        /></td>
                                    <td class="text-right">
                                        <div id="quote_qty">
                                            <span t-field="line.product_uom_qty" />
                                            <span
                                                t-field="line.product_uom"
                                                groups="uom.group_uom"
                                            />
                                        </div>
                                    </td>
                                    <td
                                        t-attf-class="text-right {{ 'd-none d-sm-table-cell' if report_type == 'html' else '' }}"
                                    >
                                        <div
                                            t-if="purchase_order.state not in ('draft', 'sent') or purchase_order.signed_on"
                                            t-esc="line.formatted_price()"
                                        />
                                        <div
                                            t-if="purchase_order.state in ('draft', 'sent') and not purchase_order.signed_on"
                                            class="input-group w-50 pull-right"
                                        >
                                            <div
                                                class="input-group-prepend d-print-none"
                                            >
                                                <span class="input-group-text">
                                                    <a
                                                        t-att-href="purchase_order.get_portal_url(suffix='/update_line/%s' % line.id, query_string='&amp;remove=True')"
                                                        class="js_update_line_json"
                                                        aria-label="Remove one"
                                                        title="Remove one"
                                                    >
                                                        <span class="fa fa-minus" />
                                                    </a>
                                                </span>
                                            </div>
                                            <!-- TODO add uom in this case too -->
                                            <!--
                                            <input type="text" class="js_po_line_price_unit form-control" t-att-data-id="line.id" t-att-value="line.price_unit"/>
                                             -->
                                             <input
                                                type="text"
                                                class="js_po_line_price_unit form-control"
                                                style="min-width: 100px;"
                                                t-att-data-id="line.id"
                                                t-att-value="line.formatted_price()"
                                            />
                                            <div
                                                class="input-group-append d-print-none"
                                            >
                                                <span class="input-group-text">
                                                    <a
                                                        t-att-href="purchase_order.get_portal_url(suffix='/update_line/%s' % line.id)"
                                                        class="js_update_line_json"
                                                        aria-label="Add one"
                                                        title="Add one"
                                                    >
                                                        <span class="fa fa-plus" />
                                                    </a>
                                                </span>
                                            </div>
                                        </div>
                                    </td>
                                    <td
                                        t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"
                                    >
                                        <span
                                            t-esc="', '.join(map(lambda x: (x.description or x.name), line.taxes_id))"
                                        />
                                    </td>
                                    <td class="text-end">
                                        <span
                                            class="oe_order_line_price_subtotal"
                                            t-field="line.price_subtotal"
                                        />
                                    </td>
                                </t>
                                <t t-if="line.display_type == 'line_section'">
                                    <td colspan="99">
                                        <span t-field="line.name" />
                                    </td>
                                    <t t-set="current_section" t-value="line" />
                                    <t t-set="current_subtotal" t-value="0" />
                                </t>
                                <t t-if="line.display_type == 'line_note'">
                                    <td colspan="99">
                                        <span t-field="line.name" />
                                    </td>
                                </t>
                            </tr>

                            <t
                                t-if="current_section and (line_last or purchase_order.order_line[line_index+1].display_type == 'line_section')"
                            >
                                <tr class="is-subtotal text-right">
                                    <td colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span
                                            t-esc="current_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": purchase_order.currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <div
                    id="total"
                    class="row"
                    name="total"
                    style="page-break-inside: avoid;"
                >
                    <div class="col-xs-7 col-md-5 ms-auto">
                        <t
                            t-call="purchase_rfq_online.purchase_order_portal_content_totals_table"
                        />
                    </div>
                </div>
            </section>

            <section t-if="purchase_order.signature" id="signature" name="Signature">
                <div class="row mt-4" name="signature">
                    <div
                        t-attf-class="#{'col-3' if report_type != 'html' else 'col-sm-7 col-md-4'} ml-auto text-center"
                    >
                        <h5>Signature</h5>
                        <img
                            t-att-src="image_data_uri(purchase_order.signature)"
                            style="max-height: 6rem; max-width: 100%;"
                        />
                        <p t-field="purchase_order.signed_by" />
                    </div>
                </div>
            </section>

            <section id="terms" class="mt-5" t-if="purchase_order.notes">
                <h3 class="">Terms &amp; Conditions</h3>
                <hr class="mt-0 mb-1" />
                <em t-field="purchase_order.notes" />
            </section>

            <section class="mt-5" t-if="purchase_order.payment_term_id">
                <h3 class="">Payment terms</h3>
                <hr class="mt-0 mb-1" />
                <span t-field="purchase_order.payment_term_id" />
            </section>
        </div>
    </template>
    <template id="purchase_order_portal_content_totals_table">
        <table class="table table-sm">
            <tr class="border-black" style="border-bottom:1px solid #dddddd;">
                <td><strong>Subtotal</strong></td>
                <td class="text-right">
                    <span
                        data-id="total_untaxed"
                        t-field="purchase_order.amount_untaxed"
                        t-options='{"widget": "monetary","display_currency": purchase_order.currency_id}'
                    />
                </td>
            </tr>
            <tr class="border-black">
                <td><strong>Total</strong></td>
                <td class="text-right">
                    <span
                        data-id="total_amount"
                        t-field="purchase_order.amount_total"
                        t-options='{"widget": "monetary", "display_currency": purchase_order.currency_id}'
                    />
                </td>
            </tr>
        </table>
    </template>
</odoo>
