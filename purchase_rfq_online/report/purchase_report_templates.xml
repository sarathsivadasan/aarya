<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
    This module does not define its own RFQ/PO report: the standard Odoo
    documents are extended so the vendor part number collected on the portal
    is printed before the product description.
    -->
    <template
        id="report_purchaseorder_document_vendor_part_no"
        inherit_id="purchase.report_purchaseorder_document"
    >
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_vendor_part_no" class="text-start"><strong>VPart No.</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <td name="td_vendor_part_no" class="text-start">
                <span t-field="line.vendor_part_no" />
            </td>
        </xpath>
    </template>

    <template
        id="report_purchasequotation_document_vendor_part_no"
        inherit_id="purchase.report_purchasequotation_document"
    >
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_vendor_part_no"><strong>VPart No.</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <td name="td_vendor_part_no">
                <span t-field="order_line.vendor_part_no" />
            </td>
        </xpath>
    </template>
</odoo>
