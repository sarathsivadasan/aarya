<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_portal_confirmed" model="ir.ui.view">
        <field name="name">sale.order.form.portal.confirmed</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']"
                   position="after">
                <field name="portal_confirmed"
                       string="Portal Confirmed"
                       widget="boolean_toggle"
                       optional="show"
                       readonly="0"/>
            </xpath>
        </field>
    </record>
</odoo>
