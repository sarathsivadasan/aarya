<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_odex_overview" model="ir.module.category">
        <field name="name">Odex Technician Overview</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_overview_technician" model="res.groups">
        <field name="name">Technician (own records)</field>
        <field name="category_id" ref="module_category_odex_overview"/>
        <field name="comment">Sees only their own live status and reports.</field>
    </record>

    <record id="group_overview_advisor" model="res.groups">
        <field name="name">Service Advisor (assigned technicians)</field>
        <field name="category_id" ref="module_category_odex_overview"/>
        <field name="implied_ids" eval="[(4, ref('group_overview_technician'))]"/>
        <field name="comment">Sees technicians on documents where they are the advisor.</field>
    </record>

    <record id="group_overview_manager" model="res.groups">
        <field name="name">Workshop Manager (all technicians)</field>
        <field name="category_id" ref="module_category_odex_overview"/>
        <field name="implied_ids" eval="[(4, ref('group_overview_advisor'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_schedule_manager" model="ir.rule">
        <field name="name">Overview Schedule: managers only</field>
        <field name="model_id" ref="model_odex_overview_report_schedule"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_overview_manager'))]"/>
    </record>
</odoo>
