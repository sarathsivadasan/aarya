<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_pdf_document">
        <html>
            <head>
                <style>
                    body { font-family: Arial, Helvetica, sans-serif; color: #2b2b3c; font-size: 12px; }
                    h1 { color: #4C3B92; font-size: 18px; margin-bottom: 2px; }
                    .meta { color: #777; margin-bottom: 12px; }
                    table { width: 100%; border-collapse: collapse; }
                    th { background: #5B4BB7; color: #fff; padding: 6px 8px; text-align: left; font-size: 11px; }
                    td { border-bottom: 1px solid #e4e2f2; padding: 5px 8px; font-size: 11px; }
                    tr:nth-child(even) td { background: #f7f6fc; }
                </style>
            </head>
            <body>
                <h1 t-out="data.get('title')"/>
                <div class="meta">Generated: <t t-out="data.get('generated_at')"/></div>
                <table>
                    <thead>
                        <tr>
                            <t t-foreach="data.get('columns', [])" t-as="col">
                                <th t-out="col[1]"/>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.get('rows', [])" t-as="row">
                            <tr>
                                <t t-foreach="data.get('columns', [])" t-as="col">
                                    <td t-out="row.get(col[0], '')"/>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </body>
        </html>
    </template>
</odoo>
