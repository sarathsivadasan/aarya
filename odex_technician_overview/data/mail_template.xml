<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_scheduled_report" model="mail.template">
        <field name="name">Odex Overview: Scheduled Report</field>
        <field name="model_id" ref="model_odex_overview_report_schedule"/>
        <field name="subject">{{ object.name }} — Workshop Report</field>
        <field name="partner_to">{{ ','.join(str(p.id) for p in object.recipient_ids) }}</field>
        <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; color: #333;">
    <p>Hello,</p>
    <p>Please find attached the scheduled workshop report
       <strong t-out="object.name"/> covering the period
       <strong t-out="dict(object._fields['period'].selection).get(object.period)"/>.</p>
    <p style="color:#5B4BB7;">Odex Workshop Management System</p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
