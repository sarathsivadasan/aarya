<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_gate_pass" model="ir.module.category">
            <field name="name">Gate Pass</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_gate_pass_technician" model="res.groups">
            <field name="name">Technician</field>
            <field name="category_id" ref="module_category_gate_pass"/>
        </record>

        <record id="group_gate_pass_reception" model="res.groups">
            <field name="name">Reception</field>
            <field name="category_id" ref="module_category_gate_pass"/>
            <field name="implied_ids" eval="[(4, ref('group_gate_pass_technician'))]"/>
        </record>

        <record id="group_gate_pass_advisor" model="res.groups">
            <field name="name">Service Advisor</field>
            <field name="category_id" ref="module_category_gate_pass"/>
            <field name="implied_ids" eval="[(4, ref('group_gate_pass_reception'))]"/>
        </record>

        <record id="group_gate_pass_manager" model="res.groups">
            <field name="name">Workshop Manager</field>
            <field name="category_id" ref="module_category_gate_pass"/>
            <field name="implied_ids" eval="[(4, ref('group_gate_pass_advisor'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Multi-company rule -->
        <record id="rule_gate_pass_company" model="ir.rule">
            <field name="name">Gate Pass: multi-company</field>
            <field name="model_id" ref="model_fleet_gate_pass"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
