<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="odex_gatepass.GatePassForm">
  <div class="ogp_page" t-att-class="{ ogp_loading: state.loading }">
    <t t-if="!state.loading">

      <!-- ============================ HEADER ============================ -->
      <div class="ogp_header">
        <div class="ogp_header_left">
          <button class="ogp_btn_outline" t-on-click="newRecord">New</button>
          <div class="ogp_title_block">
            <div class="ogp_title">Vehicle Gate Pass</div>
            <div class="ogp_subtitle">
              <span t-esc="state.rec.name"/>
              <i class="fa fa-cog ms-1"/>
            </div>
          </div>
        </div>
        <div class="ogp_header_center">
          <button class="ogp_smart" t-on-click="() => this.smart('action_view_job_card')">
            <i class="fa fa-file-text-o"/>
            <span>Job Cards<br/><b t-esc="state.rec.job_card_count"/></span>
          </button>
          <button class="ogp_smart" t-on-click="() => this.smart('action_view_invoices')">
            <i class="fa fa-file-o"/>
            <span>Invoices<br/><b t-esc="state.rec.invoice_count"/></span>
          </button>
          <button class="ogp_smart" t-on-click="() => this.smart('action_view_estimates')">
            <i class="fa fa-files-o"/>
            <span>Quotations<br/><b t-esc="state.rec.estimate_count"/></span>
          </button>
        </div>
        <div class="ogp_header_right">
          <button class="ogp_btn_outline" t-on-click="print"><i class="fa fa-print me-1"/>Print</button>
          <button class="ogp_btn_outline" t-on-click="() => state.qrOpen = true"><i class="fa fa-qrcode me-1"/>QR Code</button>
          <div class="ogp_more">
            <button class="ogp_btn_outline" t-on-click="() => state.moreOpen = !state.moreOpen">More <i class="fa fa-caret-down"/></button>
            <div class="ogp_more_menu" t-if="state.moreOpen">
              <a t-on-click="() => { state.moreOpen = false; this.smart('action_view_history'); }">Vehicle History</a>
              <a t-on-click="() => { state.moreOpen = false; this.openList(); }">All Gate Passes</a>
            </div>
          </div>
          <div class="ogp_nav">
            <span t-esc="(navIndex + 1) + ' / ' + state.ids.length"/>
            <button t-on-click="() => this.navMove(-1)" t-att-disabled="navIndex &lt;= 0"><i class="fa fa-chevron-left"/></button>
            <button t-on-click="() => this.navMove(1)" t-att-disabled="navIndex &gt;= state.ids.length - 1"><i class="fa fa-chevron-right"/></button>
          </div>
        </div>
      </div>

      <!-- ======================= ACTION BAR ======================= -->
      <div class="ogp_actionbar">
        <div>
          <button class="ogp_btn_dark" t-on-click="doOut"
                  t-att-disabled="!state.rec.id || state.rec.state === 'out'">Out</button>
          <button class="ogp_btn_dark" t-on-click="doRevisit"
                  t-att-disabled="!state.rec.id || state.rec.state !== 'in'">Revisit</button>
        </div>
        <div class="ogp_state_switch">
          <t t-foreach="state.selections.state" t-as="st" t-key="st.value">
            <div class="ogp_state_step"
                 t-att-class="{ active: state.rec.state === st.value }"
                 t-esc="st.label"/>
          </t>
        </div>
      </div>

      <!-- ========================= ROW 1 CARDS ========================= -->
      <div class="ogp_row1">
        <div class="ogp_card">
          <div class="ogp_flex_between">
            <div>
              <div class="ogp_label">Gate Pass No.</div>
              <div class="ogp_big" t-esc="state.rec.name"/>
            </div>
            <img t-if="state.rec.id" class="ogp_qr_small" t-att-src="qrUrl" t-on-click="() => state.qrOpen = true"/>
          </div>
          <div class="ogp_label mt-2">Date &amp; Time In
            <b class="ms-1" t-esc="fmtDT(state.rec.date_in)"/>
          </div>
          <div class="ogp_green_text mt-1" t-if="state.rec.state !== 'out'">Inside Workshop</div>
        </div>

        <div class="ogp_card">
          <t t-if="state.booking">
            <div class="ogp_flex_between">
              <div>
                <div class="ogp_label">Booking Status</div>
                <span class="ogp_chip_green" t-esc="state.booking.state || 'Booked'"/>
              </div>
              <div>
                <div class="ogp_label">Booking No.</div>
                <b class="ogp_link" t-on-click="openBooking" t-esc="state.booking.name"/>
              </div>
            </div>
            <div class="ogp_label mt-2">Booking Date (Customer Requested)</div>
            <div class="ogp_flex_between">
              <b t-esc="fmtDT(state.booking.date)"/>
              <button class="ogp_btn_blue" t-on-click="openBooking"><i class="fa fa-calendar me-1"/>Open Booking</button>
            </div>
            <div class="ogp_muted mt-1" t-if="state.booking.advisor">Advisor: <span t-esc="state.booking.advisor"/></div>
          </t>
          <t t-else="">
            <div class="ogp_label">Booking No.</div>
            <div class="ogp_m2o">
              <input class="ogp_input" t-att-value="state.rec.booking_ref || ''"
                     placeholder="Search booking..." t-on-input="bookingSearch"/>
              <div class="ogp_m2o_opts" t-if="state.bookingOpts.length">
                <a t-foreach="state.bookingOpts" t-as="o" t-key="o.id"
                   t-on-click="() => this.pickBooking(o)" t-esc="o.name"/>
              </div>
            </div>
            <div class="ogp_label mt-2">Promise Date (Customer Requested)</div>
            <input class="ogp_input" type="datetime-local"
                   t-att-value="state.rec.promise_date ? state.rec.promise_date.replace(' ', 'T').slice(0,16) : ''"
                   t-on-change="(ev) => this.set('promise_date', ev.target.value ? ev.target.value.replace('T',' ') + ':00' : false)"/>
          </t>
        </div>

        <div class="ogp_card">
          <div class="ogp_label">Vehicle Status</div>
          <div class="ogp_vstatus">
            <i class="fa fa-car"/>
            <span t-esc="label('vehicle_status', state.rec.vehicle_status)"/>
          </div>
          <div class="ogp_label mt-2">Change Status</div>
          <select class="ogp_input" t-on-change="onStageChange">
            <option value="">Auto</option>
            <t t-foreach="state.selections.vehicle_status" t-as="o" t-key="o.value">
              <option t-att-value="o.value"
                      t-att-selected="state.rec.vehicle_status_override === o.value"
                      t-esc="o.label"/>
            </t>
          </select>
        </div>

        <div class="ogp_card">
          <div class="ogp_label"><i class="fa fa-user-o me-1"/>Customer Type</div>
          <div class="ogp_seg">
            <t t-foreach="state.selections.customer_type" t-as="o" t-key="o.value">
              <button t-att-class="{ active: state.rec.customer_type === o.value }"
                      t-on-click="() => this.set('customer_type', o.value)"
                      t-esc="o.label"/>
            </t>
          </div>
          <div class="ogp_label mt-2">Job Type</div>
          <select class="ogp_input"
                  t-on-change="(ev) => this.set('job_type', ev.target.value)">
            <t t-foreach="state.selections.job_type" t-as="o" t-key="o.value">
              <option t-att-value="o.value"
                      t-att-selected="state.rec.job_type === o.value" t-esc="o.label"/>
            </t>
          </select>
        </div>

        <div class="ogp_card ogp_paycard">
          <t t-set="isPaid" t-value="state.rec.payment_status === 'paid'"/>
          <div class="ogp_flex">
            <div class="ogp_paycheck" t-att-class="isPaid ? 'ok' : 'no'">
              <i t-att-class="isPaid ? 'fa fa-check' : 'fa fa-times'"/>
            </div>
            <div>
              <div class="ogp_label">Payment Status</div>
              <div class="ogp_big" t-att-class="isPaid ? 'ogp_green_text' : 'ogp_red_text'"
                   t-esc="isPaid ? 'Paid' : 'Not Paid'"/>
            </div>
          </div>
          <button class="ogp_btn_outline mt-2" t-on-click="() => this.smart('action_view_invoices')">View Invoices</button>
        </div>
      </div>

      <!-- ========================= MAIN GRID ========================= -->
      <div class="ogp_main">

        <!-- LEFT COLUMN -->
        <div class="ogp_col_left">
          <div class="ogp_card">
            <div class="ogp_card_head">
              <span>Customer Information</span>
              <button class="ogp_btn_mini" t-on-click="() => state.edit.customer = !state.edit.customer">Edit</button>
            </div>
            <t t-if="!state.edit.customer">
              <div class="ogp_kv"><span>Customer Name</span><b t-esc="state.rec.partner_id ? state.rec.partner_id.name : '-'"/></div>
              <div class="ogp_kv"><span>Mobile No.</span><b t-esc="state.rec.partner_phone || '-'"/></div>
              <div class="ogp_kv"><span>Email ID</span><b t-esc="state.rec.partner_email || '-'"/></div>
              <div class="ogp_kv"><span>Alternative Contact</span><b t-esc="state.rec.alternate_contact || '-'"/></div>
            </t>
            <t t-else="">
              <div class="ogp_m2o">
                <input class="ogp_input" placeholder="Search customer..."
                       t-att-value="state.rec.partner_id ? state.rec.partner_id.name : ''"
                       t-on-input="searchPartner"/>
                <div class="ogp_m2o_opts" t-if="state.partner_id_opts and state.partner_id_opts.length">
                  <a t-foreach="state.partner_id_opts" t-as="o" t-key="o.id"
                     t-on-click="() => this.pickM2o('partner_id', o)" t-esc="o.name"/>
                </div>
              </div>
              <input class="ogp_input mt-1" placeholder="WhatsApp"
                     t-att-value="state.rec.whatsapp_number || ''"
                     t-on-change="(ev) => this.set('whatsapp_number', ev.target.value)"/>
              <input class="ogp_input mt-1" placeholder="Alternative Contact"
                     t-att-value="state.rec.alternate_contact || ''"
                     t-on-change="(ev) => this.set('alternate_contact', ev.target.value)"/>
            </t>
          </div>

          <div class="ogp_card">
            <div class="ogp_card_head">
              <span>Driver Details <small class="ogp_muted">(Optional)</small></span>
              <button class="ogp_btn_mini" t-on-click="() => state.edit.driver = !state.edit.driver">Edit</button>
            </div>
            <t t-if="!state.edit.driver">
              <div class="ogp_kv"><span>Driver Name</span><b t-esc="state.rec.driver_name || '-'"/></div>
              <div class="ogp_kv"><span>License No.</span><b t-esc="state.rec.driver_license_no || '-'"/></div>
              <div class="ogp_kv"><span>License Expiry</span><b t-esc="fmtD(state.rec.driver_license_expiry)"/></div>
              <div class="ogp_kv"><span>Mobile No.</span><b t-esc="state.rec.driver_mobile || '-'"/></div>
            </t>
            <t t-else="">
              <input class="ogp_input" placeholder="Driver Name" t-att-value="state.rec.driver_name || ''" t-on-change="(ev) => this.set('driver_name', ev.target.value)"/>
              <input class="ogp_input mt-1" placeholder="License No." t-att-value="state.rec.driver_license_no || ''" t-on-change="(ev) => this.set('driver_license_no', ev.target.value)"/>
              <input class="ogp_input mt-1" type="date" t-att-value="state.rec.driver_license_expiry || ''" t-on-change="(ev) => this.set('driver_license_expiry', ev.target.value)"/>
              <input class="ogp_input mt-1" placeholder="Mobile" t-att-value="state.rec.driver_mobile || ''" t-on-change="(ev) => this.set('driver_mobile', ev.target.value)"/>
            </t>
          </div>

          <div class="ogp_card">
            <div class="ogp_card_head"><span>Notes &amp; Remarks</span></div>
            <div class="ogp_tabs">
              <button t-att-class="{ active: state.noteTab === 'internal' }" t-on-click="() => state.noteTab = 'internal'">Internal Notes</button>
              <button t-att-class="{ active: state.noteTab === 'customer' }" t-on-click="() => state.noteTab = 'customer'">Customer Notes</button>
            </div>
            <textarea class="ogp_input ogp_textarea" t-if="state.noteTab === 'internal'"
                      t-on-change="(ev) => this.set('note', ev.target.value)"
                      t-esc="state.rec.note || ''"/>
            <textarea class="ogp_input ogp_textarea" t-else=""
                      t-on-change="(ev) => this.set('customer_note', ev.target.value)"
                      t-esc="state.rec.customer_note || ''"/>
          </div>
        </div>

        <!-- VEHICLE INFO COLUMN -->
        <div class="ogp_card ogp_col_vehicle">
          <div class="ogp_card_head">
            <span>Vehicle Information</span>
            <button class="ogp_btn_mini" t-on-click="() => state.edit.vehicle = !state.edit.vehicle">Edit</button>
          </div>
          <t t-if="!state.edit.vehicle">
            <div class="ogp_kv_scan">
              <div class="ogp_kv"><span>Registration No.</span><b t-esc="state.rec.registration_no || '-'"/></div>
              <span class="ogp_scan_group">
                <button class="ogp_btn_mini" t-on-click="() => this.openCamera('plate')"><i class="fa fa-camera me-1"/>Scan Plate</button>
                <label class="ogp_btn_mini"><i class="fa fa-upload"/><input type="file" accept="image/*" hidden="hidden" t-on-change="(ev) => this.scanUpload('plate', ev)"/></label>
              </span>
            </div>
            <div class="ogp_kv_scan">
              <div class="ogp_kv"><span>Chassis No.</span><b t-esc="state.rec.vin || '-'"/></div>
              <span class="ogp_scan_group">
                <button class="ogp_btn_mini" t-on-click="() => this.openCamera('mulkiya')"><i class="fa fa-barcode me-1"/>Scan VIN</button>
                <label class="ogp_btn_mini"><i class="fa fa-upload"/><input type="file" accept="image/*" hidden="hidden" t-on-change="(ev) => this.scanUpload('mulkiya', ev)"/></label>
              </span>
            </div>
            <div class="ogp_kv"><span>Engine No.</span><b t-esc="state.rec.engine_no || '-'"/></div>
            <div class="ogp_kv"><span>Brand</span><b t-esc="state.rec.brand_id ? state.rec.brand_id.name : '-'"/></div>
            <div class="ogp_kv"><span>Model</span><b t-esc="state.rec.model_id ? state.rec.model_id.name : '-'"/></div>
            <div class="ogp_kv"><span>Manufacturing Year</span><b t-esc="state.rec.manufacturing_year || '-'"/></div>
            <div class="ogp_kv"><span>Color</span><b t-esc="state.rec.vehicle_color_id ? state.rec.vehicle_color_id.name : '-'"/></div>
            <div class="ogp_kv"><span>Job Type</span><b t-esc="label('job_type', state.rec.job_type)"/></div>
            <div class="ogp_kv"><span>Fuel Type</span><b t-esc="label('fuel_type', state.rec.fuel_type)"/></div>
            <div class="ogp_kv"><span>Transmission</span><b t-esc="label('transmission', state.rec.transmission)"/></div>
            <div class="ogp_kv"><span>Engine Capacity</span><b t-esc="state.rec.engine_capacity || '-'"/></div>
            <div class="ogp_kv"><span>Plate Source</span><b t-esc="state.rec.plate_source || '-'"/></div>
            <div class="ogp_kv"><span>Odometer (KM)</span><b t-esc="state.rec.odometer || '-'"/></div>
          </t>
          <t t-else="">
            <div class="ogp_m2o">
              <input class="ogp_input" placeholder="Search vehicle..."
                     t-att-value="state.rec.vehicle_id ? state.rec.vehicle_id.name : ''"
                     t-on-input="searchVehicle"/>
              <div class="ogp_m2o_opts" t-if="state.vehicle_id_opts and state.vehicle_id_opts.length">
                <a t-foreach="state.vehicle_id_opts" t-as="o" t-key="o.id"
                   t-on-click="() => this.pickM2o('vehicle_id', o)" t-esc="o.name"/>
              </div>
            </div>
            <input class="ogp_input mt-1" placeholder="Registration No." t-att-value="state.rec.registration_no || ''" t-on-change="(ev) => this.set('registration_no', ev.target.value)"/>
            <input class="ogp_input mt-1" placeholder="VIN / Chassis" t-att-value="state.rec.vin || ''" t-on-change="(ev) => this.set('vin', ev.target.value)"/>
            <input class="ogp_input mt-1" placeholder="Engine No." t-att-value="state.rec.engine_no || ''" t-on-change="(ev) => this.set('engine_no', ev.target.value)"/>
            <input class="ogp_input mt-1" placeholder="Variant" t-att-value="state.rec.variant || ''" t-on-change="(ev) => this.set('variant', ev.target.value)"/>
            <input class="ogp_input mt-1" placeholder="Manufacturing Year" t-att-value="state.rec.manufacturing_year || ''" t-on-change="(ev) => this.set('manufacturing_year', ev.target.value)"/>
            <select class="ogp_input mt-1" t-on-change="(ev) => this.set('fuel_type', ev.target.value)">
              <option value="">Fuel Type...</option>
              <t t-foreach="state.selections.fuel_type" t-as="o" t-key="o.value">
                <option t-att-value="o.value" t-att-selected="state.rec.fuel_type === o.value" t-esc="o.label"/>
              </t>
            </select>
            <select class="ogp_input mt-1" t-on-change="(ev) => this.set('transmission', ev.target.value)">
              <option value="">Transmission...</option>
              <t t-foreach="state.selections.transmission" t-as="o" t-key="o.value">
                <option t-att-value="o.value" t-att-selected="state.rec.transmission === o.value" t-esc="o.label"/>
              </t>
            </select>
            <input class="ogp_input mt-1" placeholder="Engine Capacity" t-att-value="state.rec.engine_capacity || ''" t-on-change="(ev) => this.set('engine_capacity', ev.target.value)"/>
            <input class="ogp_input mt-1" placeholder="Plate Source" t-att-value="state.rec.plate_source || ''" t-on-change="(ev) => this.set('plate_source', ev.target.value)"/>
            <input class="ogp_input mt-1" type="number" placeholder="Odometer (KM)" t-att-value="state.rec.odometer || ''" t-on-change="(ev) => this.set('odometer', parseFloat(ev.target.value) || 0)"/>
          </t>
        </div>

        <!-- RIGHT SIDEBAR -->
        <div class="ogp_col_side">
          <div class="ogp_card">
            <div class="ogp_flex">
              <div class="ogp_cal_icon"><i class="fa fa-calendar"/></div>
              <div>
                <div class="ogp_label">Promise Date</div>
                <b t-esc="fmtDT(state.rec.promise_date)"/>
              </div>
            </div>
          </div>
          <div class="ogp_card">
            <div class="ogp_card_head">
              <span>Entry / Exit Logs</span>
              <button class="ogp_btn_mini" t-on-click="() => state.logsAll = !state.logsAll"
                      t-esc="state.logsAll ? 'Less' : 'View All'"/>
            </div>
            <table class="ogp_logs">
              <thead><tr><th>Type</th><th>Date &amp; Time</th><th>By</th></tr></thead>
              <tbody>
                <tr t-foreach="visibleLogs" t-as="log" t-key="log.id">
                  <td><span class="ogp_logtype" t-att-class="'ogp_log_' + log.log_type" t-esc="label('log_type', log.log_type)"/></td>
                  <td t-esc="fmtDT(log.date)"/>
                  <td t-esc="log.user_id ? log.user_id[1] : ''"/>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- REMARKS & COMPLAINTS -->
        <div class="ogp_card ogp_col_remarks">
          <div class="ogp_card_head"><span>Remarks &amp; Complaints</span></div>
          <div class="ogp_label">Customer Complaints</div>
          <textarea class="ogp_input ogp_textarea" placeholder="What the customer reports..."
                    t-on-change="(ev) => this.set('customer_complaint', ev.target.value)"
                    t-esc="state.rec.customer_complaint || ''"/>
          <div class="ogp_label mt-2">Remarks</div>
          <textarea class="ogp_input ogp_textarea" placeholder="Reception / advisor remarks..."
                    t-on-change="(ev) => this.set('condition_remarks', ev.target.value)"
                    t-esc="state.rec.condition_remarks || ''"/>
        </div>

        <div class="ogp_card ogp_col_timeline">
          <div class="ogp_card_head"><span>Timeline / Status Flow</span></div>
          <div class="ogp_timeline">
            <div class="ogp_tl_row" t-foreach="timelineRows" t-as="row" t-key="row.event">
              <span class="ogp_tl_dot" t-att-class="{ done: row.done }"/>
              <span class="ogp_tl_date" t-esc="row.date || '—'"/>
              <b class="ogp_tl_title" t-esc="row.title"/>
              <span class="ogp_tl_by" t-esc="row.done ? (row.by ? 'By: ' + row.by : '') : 'Pending'"/>
            </div>
          </div>
        </div>
      </div>

      <!-- ========================== FOOTER ========================== -->
      <div class="ogp_footer">
        <div>
          <button class="ogp_btn_green" t-on-click="() => this.save(false)" t-att-disabled="state.saving">
            <i class="fa fa-save me-1"/>Save
          </button>
          <button class="ogp_btn_outline" t-on-click="() => this.save(true)" t-att-disabled="state.saving">
            <i class="fa fa-plus me-1"/>Save &amp; New
          </button>
          <button class="ogp_btn_outline" t-on-click="cancel">
            <i class="fa fa-times me-1"/>Cancel
          </button>
        </div>
        <div class="ogp_footer_checks">
          <label>
            <input type="checkbox" t-att-checked="state.rec.send_whatsapp_notification"
                   t-on-change="(ev) => this.set('send_whatsapp_notification', ev.target.checked)"/>
            Send WhatsApp Notification
          </label>
          <label>
            <input type="checkbox" t-att-checked="state.rec.send_sms_notification"
                   t-on-change="(ev) => this.set('send_sms_notification', ev.target.checked)"/>
            Send SMS Notification
          </label>
        </div>
      </div>

      <!-- ========================== MODALS ========================== -->
      <div class="ogp_modal ogp_camera_modal" t-if="state.camera.open">
        <div class="ogp_camera_box" t-on-click.stop="">
          <div class="ogp_camera_title"
               t-esc="state.camera.mode === 'plate' ? 'Scan Registration Plate' : 'Scan Mulkiya / VIN'"/>
          <video t-ref="cameraVideo" autoplay="autoplay" playsinline="playsinline" muted="muted"/>
          <div class="ogp_camera_err" t-if="state.camera.error" t-esc="state.camera.error"/>
          <div class="ogp_flex mt-2" style="justify-content: center;">
            <button class="ogp_btn_green" t-on-click="captureFrame" t-att-disabled="state.camera.error !== ''">
              <i class="fa fa-camera me-1"/>Capture
            </button>
            <button class="ogp_btn_outline" t-on-click="closeCamera">Cancel</button>
          </div>
        </div>
      </div>
      <div class="ogp_modal" t-if="state.qrOpen" t-on-click="() => state.qrOpen = false">
        <div class="ogp_qr_big">
          <img t-att-src="qrUrl"/>
          <div t-esc="state.rec.name"/>
        </div>
      </div>
    </t>
    <div class="ogp_spinner" t-else=""><i class="fa fa-spinner fa-spin"/></div>
  </div>
</t>

</templates>
