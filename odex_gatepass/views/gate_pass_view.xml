<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ========================== FORM ========================== -->
        <record id="gate_pass_form_view" model="ir.ui.view">
            <field name="name">vehicle.gate.pass.form.view</field>
            <field name="model">fleet.gate.pass</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="vehicle_out" type="object" string="Out"
                                invisible="state not in ('in', 'revisit')"
                                class="btn-primary"/>
                        <button name="vehicle_revisit" type="object" string="Revisit"
                                invisible="state != 'in'" class="btn-primary"/>
                        <button name="action_create_vehicle_inspection" type="object"
                                string="Create Vehicle Inspection"
                                class="btn-secondary"
                                invisible="inspection_count >= 1 or state == 'out'"/>
                        <field name="state" widget="statusbar" string="Status"
                               statusbar_visible="in,revisit,out"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_vehicle_inspection" type="object"
                                    class="oe_stat_button" icon="fa-car"
                                    invisible="inspection_count == 0">
                                <field name="inspection_count" widget="statinfo" string="Vehicle Inspection"/>
                            </button>
                            <button name="action_view_estimates" type="object"
                                    class="oe_stat_button" icon="fa-file-o"
                                    invisible="estimate_count == 0">
                                <field name="estimate_count" widget="statinfo" string="Quotations"/>
                            </button>
                            <button name="action_view_job_card" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o"
                                    invisible="job_card_count == 0">
                                <field name="job_card_count" widget="statinfo" string="Job Cards"/>
                            </button>
                            <button name="action_view_invoices" type="object"
                                    class="oe_stat_button" icon="fa-pencil-square-o"
                                    invisible="invoice_count == 0">
                                <field name="invoice_count" widget="statinfo" string="Invoices"/>
                            </button>
                            <button name="action_view_history" type="object"
                                    class="oe_stat_button" icon="fa-history"
                                    invisible="history_count == 0">
                                <field name="history_count" widget="statinfo" string="History"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Delivered" bg_color="text-bg-success"
                                invisible="state != 'out'"/>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Status">
                                <field name="vehicle_status" widget="badge"
                                       decoration-success="vehicle_status in ('in_workshop','ready_for_delivery')"
                                       decoration-warning="vehicle_status in ('under_inspection','waiting_approval')"
                                       decoration-info="vehicle_status in ('repair_in_progress','invoice_ready')"
                                       decoration-danger="vehicle_status == 'revisit'"/>
                                <field name="payment_status" widget="badge"
                                       decoration-success="payment_status == 'paid'"
                                       decoration-danger="payment_status == 'not_paid'"/>
                                <field name="job_type"/>
                                <field name="customer_type" widget="radio" options="{'horizontal': true}"/>
                                <field name="out_reason" invisible="state == 'in'"/>
                            </group>
                            <group string="Dates">
                                <field name="date_in"/>
                                <field name="promise_date"/>
                                <field name="date_out" readonly="1"/>
                                <field name="advisor_id" widget="many2one_avatar_user"/>
                                <field name="approved_id" readonly="state != 'in'"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group string="Booking Information" name="booking_info">
                            <group>
                                <field name="booking_ref"/>
                            </group>
                            <group/>
                        </group>
                        <notebook>
                            <page string="Customer &amp; Vehicle" name="page_main">
                                <group>
                                    <group string="Customer Information">
                                        <field name="partner_id" readonly="state == 'out'"/>
                                        <field name="partner_phone"/>
                                        <field name="partner_email"/>
                                        <field name="whatsapp_number"/>
                                        <field name="alternate_contact" readonly="state != 'in'"/>
                                        <field name="alternate_mobile" readonly="state != 'in'"/>
                                        <field name="partner_address"/>
                                    </group>
                                    <group string="Vehicle Information">
                                        <field name="vehicle_id" readonly="state != 'in'"/>
                                        <field name="registration_no"/>
                                        <field name="vin"/>
                                        <field name="engine_no"/>
                                        <field name="brand_id"/>
                                        <field name="model_id"/>
                                        <field name="variant"/>
                                        <field name="manufacturing_year"/>
                                        <field name="vehicle_color_id"/>
                                        <field name="fuel_type"/>
                                        <field name="transmission"/>
                                        <field name="engine_capacity"/>
                                        <field name="plate_source"/>
                                        <field name="odometer"/>
                                    </group>
                                </group>
                                <group>
                                    <group string="Driver Details (Optional)">
                                        <field name="driver_name"/>
                                        <field name="driver_license_no"/>
                                        <field name="driver_license_expiry"/>
                                        <field name="driver_mobile"/>
                                    </group>
                                    <group string="Remarks &amp; Complaints">
                                        <field name="customer_complaint"/>
                                        <field name="condition_remarks"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Timeline" name="page_timeline">
                                <field name="timeline_ids" readonly="1">
                                    <list>
                                        <field name="date"/>
                                        <field name="event" widget="badge"/>
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Entry / Exit Logs" name="page_logs">
                                <field name="log_ids" readonly="1">
                                    <list>
                                        <field name="log_type" widget="badge"
                                               decoration-success="log_type == 'in'"
                                               decoration-danger="log_type == 'out'"
                                               decoration-warning="log_type in ('revisit','rework')"/>
                                        <field name="date"/>
                                        <field name="user_id"/>
                                        <field name="advisor_id"/>
                                        <field name="remarks"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="page_notes">
                                <group>
                                    <field name="note" placeholder="Internal notes..."/>
                                    <field name="customer_note" placeholder="Customer notes..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter reload_on_follower="True"/>
                </form>
            </field>
        </record>

        <!-- ========================== LIST ========================== -->
        <record id="gate_pass_tree_view" model="ir.ui.view">
            <field name="name">vehicle.gate.pass.view.list</field>
            <field name="model">fleet.gate.pass</field>
            <field name="arch" type="xml">
                <list js_class="odex_gatepass_list" decoration-success="vehicle_status == 'ready_for_delivery'"
                      decoration-muted="vehicle_status == 'delivered'"
                      sample="1" multi_edit="1">
                    <button name="action_open_custom_form" type="object"
                            icon="fa-external-link" title="Open Gate Pass"/>
                    <field name="name" string="Gate Pass No."/>
                    <field name="registration_no" string="Registration No." optional="show"/>
                    <field name="partner_id" string="Customer"/>
                    <field name="partner_phone" string="Mobile" optional="show"/>
                    <field name="brand_id" optional="show"/>
                    <field name="model_id" optional="show"/>
                    <field name="vehicle_color_id" optional="hide"/>
                    <field name="vehicle_status" widget="badge"
                           decoration-success="vehicle_status in ('in_workshop','ready_for_delivery')"
                           decoration-warning="vehicle_status in ('under_inspection','waiting_approval')"
                           decoration-info="vehicle_status in ('repair_in_progress','invoice_ready')"
                           decoration-danger="vehicle_status == 'revisit'"
                           decoration-muted="vehicle_status == 'delivered'"/>
                    <field name="inspection_status" widget="badge" optional="show"
                           decoration-warning="inspection_status == 'pending'"
                           decoration-info="inspection_status == 'in_progress'"
                           decoration-success="inspection_status == 'completed'"/>
                    <field name="estimate_status" widget="badge" optional="show"
                           decoration-warning="estimate_status == 'pending'"
                           decoration-success="estimate_status == 'approved'"
                           decoration-danger="estimate_status == 'rejected'"/>
                    <field name="job_card_status" widget="badge" optional="show"
                           decoration-info="job_card_status in ('open','in_progress')"
                           decoration-success="job_card_status == 'completed'"/>
                    <field name="invoice_status" widget="badge" optional="show"
                           decoration-info="invoice_status == 'generated'"
                           decoration-success="invoice_status == 'paid'"/>
                    <field name="state" widget="badge" string="Gate Pass"
                           decoration-success="state == 'in'"
                           decoration-warning="state == 'revisit'"
                           decoration-muted="state == 'out'"/>
                    <field name="booking_ref" string="Booking" optional="show"/>
                    <field name="odometer" string="Odometer (KM)" optional="show"/>
                    <field name="advisor_id" string="Adviser" widget="many2one_avatar_user" optional="show"/>
                    <field name="date_in"/>
                    <field name="is_overdue" column_invisible="1"/>
                    <field name="promise_date" optional="show"
                           decoration-danger="is_overdue"/>
                    <field name="date_out" optional="show"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <field name="customer_type" optional="hide"/>
                    <field name="payment_status" widget="badge" optional="show"
                           decoration-success="payment_status == 'paid'"
                           decoration-danger="payment_status == 'not_paid'"/>
                </list>
            </field>
        </record>

        <!-- ========================== KANBAN ========================== -->
        <record id="gate_pass_kanban_view" model="ir.ui.view">
            <field name="name">vehicle.gate.pass.view.kanban</field>
            <field name="model">fleet.gate.pass</field>
            <field name="arch" type="xml">
                <kanban default_group_by="vehicle_status" sample="1">
                    <field name="name"/>
                    <field name="vehicle_status"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card p-2">
                                <div class="d-flex justify-content-between">
                                    <strong><field name="name"/></strong>
                                    <field name="state" widget="badge"/>
                                </div>
                                <div><field name="partner_id"/></div>
                                <div class="text-muted">
                                    <field name="registration_no"/> · <field name="model_id"/>
                                </div>
                                <div class="d-flex justify-content-between mt-1">
                                    <field name="promise_date" widget="datetime"/>
                                    <field name="advisor_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ========================== SEARCH ========================== -->
        <record id="gate_pass_search_view" model="ir.ui.view">
            <field name="name">vehicle.gate.pass.view.search</field>
            <field name="model">fleet.gate.pass</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Gate Pass"
                           filter_domain="['|','|','|','|','|',
                               ('name','ilike',self),
                               ('partner_id','ilike',self),
                               ('partner_phone','ilike',self),
                               ('registration_no','ilike',self),
                               ('vin','ilike',self),
                               ('alternate_mobile','ilike',self)]"/>
                    <field name="partner_id"/>
                    <field name="vehicle_id"/>
                    <field name="registration_no"/>
                    <field name="vin"/>
                    <field name="advisor_id"/>
                    <field name="booking_ref"/>
                    <separator/>
                    <filter name="filter_in" string="IN (Inside Workshop)"
                            domain="[('state','in',('in','revisit'))]"/>
                    <filter name="filter_out" string="OUT (Delivered)"
                            domain="[('state','=','out')]"/>
                    <filter name="filter_revisit" string="Revisit / Rework"
                            domain="[('vehicle_status','=','revisit')]"/>
                    <separator/>
                    <filter name="filter_inspection_pending" string="Inspection Pending"
                            domain="[('inspection_status','=','pending'),('state','!=','out')]"/>
                    <filter name="filter_estimation_pending" string="Estimation Pending"
                            domain="[('inspection_status','=','completed'),('estimate_status','in',('none','pending')),('state','!=','out')]"/>
                    <filter name="filter_job_card_open" string="Job Card Open"
                            domain="[('job_card_status','in',('open','in_progress'))]"/>
                    <filter name="filter_invoice_generated" string="Invoice Generated"
                            domain="[('invoice_status','in',('generated','paid'))]"/>
                    <filter name="filter_ready" string="Ready for Delivery"
                            domain="[('vehicle_status','=','ready_for_delivery')]"/>
                    <separator/>
                    <filter name="filter_paid" string="Paid"
                            domain="[('payment_status','=','paid')]"/>
                    <filter name="filter_not_paid" string="Not Paid"
                            domain="[('payment_status','=','not_paid')]"/>
                    <separator/>
                    <filter name="filter_today" string="Today's IN"
                            domain="[('date_in','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                     ('date_in','&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"/>
                    <filter name="filter_promise_overdue" string="Promise Overdue"
                            domain="[('is_overdue','=',True)]"/>
                    <separator/>
                    <filter name="filter_my" string="My Gate Passes"
                            domain="[('advisor_id','=',uid)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_state" string="Gate Pass Status" context="{'group_by':'state'}"/>
                        <filter name="group_vehicle_status" string="Vehicle Status" context="{'group_by':'vehicle_status'}"/>
                        <filter name="group_advisor" string="Advisor" context="{'group_by':'advisor_id'}"/>
                        <filter name="group_customer" string="Customer" context="{'group_by':'partner_id'}"/>
                        <filter name="group_brand" string="Brand" context="{'group_by':'brand_id'}"/>
                        <filter name="group_date_in" string="Date In" context="{'group_by':'date_in:day'}"/>
                        <filter name="group_job_type" string="Job Type" context="{'group_by':'job_type'}"/>
                        <filter name="group_payment" string="Payment Status" context="{'group_by':'payment_status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Custom OWL form client action -->
        <record id="action_gate_pass_custom_form" model="ir.actions.client">
            <field name="name">Vehicle Gate Pass</field>
            <field name="tag">odex_gatepass_form</field>
        </record>

        <!-- ========================== ACTION / MENU ========================== -->
        <record model="ir.actions.act_window" id="action_gate_pass">
            <field name="name">Vehicle Gate Pass</field>
            <field name="res_model">fleet.gate.pass</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="gate_pass_search_view"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create your first Gate Pass</p>
            </field>
        </record>

        <menuitem id="menu_gate_pass_parent" name="Gate Pass" groups="base.group_user"/>
        <menuitem id="menu_item_gate_pass" name="Gate Pass" parent="menu_gate_pass_parent"/>
        <menuitem id="menu_action_gate_pass" name="Gate Pass" parent="menu_item_gate_pass" action="action_gate_pass"/>
        <menuitem id="menu_action_gate_pass_form" name="New Gate Pass" parent="menu_item_gate_pass" action="action_gate_pass_custom_form"/>

    </data>
</odoo>
