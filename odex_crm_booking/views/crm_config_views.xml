<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="odex_crm_business_view_list" model="ir.ui.view">
        <field name="name">odex.crm.business.list</field>
        <field name="model">odex.crm.business</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="odex_crm_business_action" model="ir.actions.act_window">
        <field name="name">Business</field>
        <field name="res_model">odex.crm.business</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="odex_crm_customer_type_view_list" model="ir.ui.view">
        <field name="name">odex.crm.customer.type.list</field>
        <field name="model">odex.crm.customer.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="odex_crm_customer_type_action" model="ir.actions.act_window">
        <field name="name">Customer Types</field>
        <field name="res_model">odex.crm.customer.type</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="action_odex_booking_integration_setup" model="ir.actions.server">
        <field name="name">Booking Integration</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">action = env['odex.crm.booking.bridge'].action_setup()</field>
    </record>

    <!-- Light vehicle form used when a vehicle is created from a lead:
         the full fleet form computes contract/service counters that sales users cannot read. -->
    <record id="fleet_vehicle_view_form_crm_quick" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.odex.crm.quick</field>
        <field name="model">fleet.vehicle</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <sheet>
                    <group>
                        <group>
                            <field name="license_plate" required="1"/>
                            <field name="model_id" required="1"/>
                            <field name="vin_sn"/>
                        </group>
                        <group>
                            <field name="driver_id" string="Customer"/>
                            <field name="color"/>
                            <field name="model_year"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
