<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bank_reco" model="ir.module.category">
        <field name="name">Bank Reconciliation Pro</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_bank_reco_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_bank_reco"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
        <field name="comment">Can view and reconcile bank entries.</field>
    </record>

    <record id="group_bank_reco_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_bank_reco"/>
        <field name="implied_ids" eval="[(4, ref('group_bank_reco_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Full access including reset and adjustments.</field>
    </record>
</odoo>
