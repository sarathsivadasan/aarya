<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════
         Client Action – launches the OWL component
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_bank_reconciliation_pro" model="ir.actions.client">
        <field name="name">Bank Reconciliation</field>
        <field name="tag">bank_reco_pro_action</field>
        <field name="target">main</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         Standard List View (fallback / admin debugging)
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_bank_reco_line_list" model="ir.ui.view">
        <field name="name">bank.reco.line.list</field>
        <field name="model">bank.reco.line</field>
        <field name="arch" type="xml">
            <list string="Bank Reconciliation Lines" decoration-success="is_reconciled == True"
                  decoration-warning="is_reconciled == False">
                <field name="date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="debit"/>
                <field name="credit"/>
                <field name="cleared_date"/>
                <field name="status"/>
                <field name="is_reconciled" invisible="1"/>
                <button name="action_reconcile" string="Reconcile" type="object"
                        icon="fa-check-circle" invisible="is_reconciled"/>
            </list>
        </field>
    </record>

    <record id="view_bank_reco_line_form" model="ir.ui.view">
        <field name="name">bank.reco.line.form</field>
        <field name="model">bank.reco.line</field>
        <field name="arch" type="xml">
            <form string="Bank Reconciliation Line">
                <header>
                    <button name="action_reconcile" string="Reconcile" type="object"
                            class="btn-primary" invisible="is_reconciled"/>
                    <button name="action_unreconcile" string="Unreconcile" invisible="not is_reconciled" type="object"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Transaction Details">
                            <field name="name"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="journal_id"/>
                            <field name="debit"/>
                            <field name="credit"/>
                        </group>
                        <group string="Reconciliation">
                            <field name="is_reconciled"/>
                            <field name="cleared_date"/>
                            <field name="bank_date"/>
                            <field name="bank_reference"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bank_reco_line_list" model="ir.actions.act_window">
        <field name="name">Reconciliation Lines</field>
        <field name="res_model">bank.reco.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bank_reco_line_list"/>
    </record>
</odoo>
